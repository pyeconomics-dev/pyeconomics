---
// web/src/components/Header.astro
// The site header: the mark and wordmark, the main navigation, the search box
// and the fifteen domain sections in ROADMAP §4 7.2's order (ADR-0013
// decision 10). On a wide screen the sections are a row of links; on a small
// one they sit in a <details> disclosure, which browsers make operable from the
// keyboard with no script. The search box is an island hydrated only when a
// visitor reaches for it (client:interaction), and until then a plain form
// that opens /search/. The mark is the font-free brand SVG; the wordmark is
// text in the system font.
import SearchBox from "@/components/search/SearchBox";
import { NAVIGATION } from "@/lib/links";
import { DOMAINS, domainPath } from "@/lib/paths";

const here = Astro.url.pathname;
const current = (path: string) => (here.startsWith(path) ? "page" : undefined);
const linkClass = "text-foreground hover:text-link aria-[current=page]:font-semibold";
---

<header class="border-b">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-foreground no-underline">
      <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
      <span class="text-xl font-semibold tracking-tight">pyeconomics</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        {
          NAVIGATION.map((link) => (
            <li>
              <a href={link.href} class={linkClass} aria-current={link.href === here ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div data-slot="search" class="w-full sm:w-auto">
      <SearchBox client:interaction />
    </div>
  </div>
  <nav aria-label="Domains" class="mx-auto max-w-5xl px-4 pb-3 text-sm" data-domains="">
    <details class="lg:hidden" data-domains-menu="">
      <summary class="w-fit cursor-pointer rounded-md py-1 font-medium">Domains</summary>
      <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
        {
          DOMAINS.map((domain) => (
            <li>
              <a href={domainPath(domain.id)} class={linkClass} aria-current={current(domainPath(domain.id))}>
                {domain.title}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <ul class="hidden flex-wrap gap-x-4 gap-y-1 lg:flex" data-domains-row="">
      {
        DOMAINS.map((domain) => (
          <li>
            <a href={domainPath(domain.id)} class={linkClass} aria-current={current(domainPath(domain.id))}>
              {domain.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
