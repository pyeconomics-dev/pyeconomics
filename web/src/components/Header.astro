---
// web/src/components/Header.astro
// The site header (Phase 5 Step 17's design; ADR-0013 decision 10): the mark
// and wordmark, the main navigation, the search box and the fifteen domain
// sections in ROADMAP §4 7.2's order. On a wide screen (lg and up) the main
// links and the search box share the first row and the sections are a second
// row of links. Below that, the header is one row: the mark, a link to
// /search/ and a "Menu" disclosure whose panel opens beneath the header,
// holding the sections first (so Tab from the summary reaches Foundations)
// and the main links after them; browsers make a <details> operable from the
// keyboard with no script. The search box is an
// island hydrated only when a visitor reaches for it (client:interaction),
// and until then a plain form that opens /search/. The mark is the font-free
// brand SVG; the wordmark is text in the site's face.
import SearchBox from "@/components/search/SearchBox";
import { NAVIGATION } from "@/lib/links";
import { DOMAINS, domainPath } from "@/lib/paths";

const here = Astro.url.pathname;
const current = (path: string) => (here.startsWith(path) ? "page" : undefined);
const mainCurrent = (href: string) => (href.startsWith("/") && here.startsWith(href) ? "page" : undefined);
---

<header class="site-header">
  <div class="relative mx-auto flex max-w-6xl items-center gap-x-6 px-4 py-2 lg:py-3">
    <a href="/" class="brand flex shrink-0 items-center gap-2 no-underline">
      <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
      <span class="brand-name">pyeconomics</span>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-x-1 text-sm">
        {
          NAVIGATION.map((link) => (
            <li>
              <a href={link.href} class="nav-link" aria-current={mainCurrent(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div data-slot="search" class="ml-auto hidden w-72 lg:block">
      <SearchBox client:interaction />
    </div>
    <a href="/search/" class="icon-link ml-auto lg:hidden" aria-label="Search the site">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    </a>
    <nav aria-label="Domains" class="lg:hidden">
      <details class="site-menu" data-domains-menu="">
        <summary class="menu-toggle">Menu</summary>
        <div class="menu-panel text-sm">
          <p class="menu-heading">Domains</p>
          <ul class="grid grid-cols-2 gap-x-4 sm:grid-cols-3">
            {
              DOMAINS.map((domain) => (
                <li>
                  <a href={domainPath(domain.id)} class="menu-link" aria-current={current(domainPath(domain.id))}>
                    {domain.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="menu-heading">Site</p>
          <ul class="grid grid-cols-2 gap-x-4 sm:grid-cols-3">
            {
              NAVIGATION.map((link) => (
                <li>
                  <a href={link.href} class="menu-link" aria-current={mainCurrent(link.href)}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </nav>
  </div>
  <nav aria-label="Domains" class="mx-auto hidden max-w-6xl text-sm lg:block" data-domains="">
    <ul class="domains-row flex flex-wrap gap-x-1 px-4 pb-2" data-domains-row="">
      {
        DOMAINS.map((domain) => (
          <li>
            <a href={domainPath(domain.id)} class="domain-link" aria-current={current(domainPath(domain.id))}>
              {domain.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
