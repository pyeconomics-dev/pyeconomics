---
// web/src/components/Footer.astro
// The footer every page carries: the CFA® marks notice verbatim (ROADMAP §5
// "CFA Institute marks and content"), the notice everything carries ("As is;
// not investment advice"), and links to the terms of use, the privacy policy,
// the disclaimers, the data sources and their notices, the licence page (Phase 5
// Step 16), the repository, Discussions, the newsletter,
// the Pro preview, the documentation and the service's status page, in four
// groups under short headings (Step 18's round 2); and, beside them, the
// newsletter's sign-up form (Phase 5 Step 15), left out on the pages that
// carry their own form.
import SignupForm from "@/components/SignupForm.astro";
import { AS_IS_NOTICE, CFA_NOTICE, FOOTER_GROUPS } from "@/lib/links";
import { version } from "@/lib/site-data";

interface Props {
  /** Whether the footer carries the newsletter form. */
  signup?: boolean;
}

const { signup = true } = Astro.props;
---

<footer class="site-footer mt-16 text-sm">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10">
    <p data-notice="as-is" class="font-medium text-foreground">{AS_IS_NOTICE}</p>
    <p data-notice="cfa">{CFA_NOTICE}</p>
    {
      signup && (
        <section aria-labelledby="footer-newsletter" data-pagefind-ignore="all">
          <h2 id="footer-newsletter" class="mb-2 font-medium text-foreground">
            Newsletter
          </h2>
          <SignupForm list="newsletter" source="footer" id="footer-signup" compact />
        </section>
      )
    }
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-4">
      {
        FOOTER_GROUPS.map((group) => (
          <div data-footer-group={group.title}>
            <h2 class="mb-2 font-medium text-foreground">{group.title}</h2>
            <ul class="flex flex-col gap-2">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <p>pyeconomics {version}</p>
  </div>
</footer>
