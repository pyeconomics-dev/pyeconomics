---
// web/src/components/models/ModelPage.astro
// One model's page, generated from its registry.json entry (Phase 5 Step 5;
// ADR-0013 decision 2). The sections, in order: summary, formula, variables,
// calculator, worked example, assumptions, limitations, evidence, syllabus
// (its topic tags from syllabi/, each linking to the issuing body), data (a
// bound model only), citations, changelog, related models (computed at build
// time: src/lib/catalog.ts relatedModels) and where else to use the model.
// A model whose bound data the hosted site may not serve says which sources
// and gives the local app's command beside its calculator (Phase 5 Step 9),
// and each bound concept links to its page under /data/. A model whose outputs
// are simulated or hypothetical (its registry tags; src/lib/legal.ts) carries
// the hypothetical-results legend beside the calculator's result and the
// worked example's outputs (Phase 5 Step 16).
// Search indexes the page (data-pagefind-body on its main landmark) with the
// model's domain and summary as its result's text; the calculator's loading
// text and form are not page content, so search ignores that section.
//
// Card text is trusted repository content, and it still reaches HTML only
// through Astro's escaping: no value is rendered with set:html except a
// formula, which KaTeX renders at build time as MathML with no command trusted
// (src/lib/math.ts), and the page's JSON-LD, which escapes every character that
// could end its element (src/lib/structured-data.ts). The one script is the
// calculator island (Phase 5 Step 6), hydrated when it scrolls into view
// (client:visible): its props are small, and it loads its model's schema,
// examples and precompiled validators as a chunk of their own.
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Math from "@/components/Math.astro";
import Calculator from "@/components/calculator/Calculator";
import HypotheticalLegend from "@/components/models/HypotheticalLegend.astro";
import VariablesTable from "@/components/models/VariablesTable.astro";
import Base from "@/layouts/Base.astro";
import { calculations, calculatorProps, formRoom } from "@/lib/calculator";
import { relatedModels, topicsOf } from "@/lib/catalog";
import {
  COST_MEANING,
  EVIDENCE_MEANING,
  cardOrder,
  dataProfiles,
  describe,
  docsUrl,
  domainPath,
  domainTitle,
  liveNotice,
  modelPath,
  pretty,
  referenceLink,
  symbolsOf,
  variables,
} from "@/lib/models";
import { LOCAL_APP } from "@/lib/explorer";
import { simulates } from "@/lib/legal";
import { cliSnippet, pythonSnippet } from "@/lib/snippets";
import { conceptPath } from "@/lib/paths";
import { profileLabel, profileName } from "@/lib/profiles";
import type { Model } from "@/lib/registry-schema";
import { prerelease } from "@/lib/mcp";
import { conceptData, problemData, sourceData, syllabusData, version, type SurfaceEntry } from "@/lib/site-data";
import { modelPage, type Crumb } from "@/lib/structured-data";

interface Props {
  model: Model;
  surface: SurfaceEntry;
  /** Every model, for the related models. */
  models: readonly Model[];
}

const { model, surface, models } = Astro.props;
const path = modelPath(model.id);
const trail: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Models", path: "/models/" },
  { name: domainTitle(model.domain), path: domainPath(model.domain) },
  { name: model.title, path },
];
const inputs = variables(model.input_schema, cardOrder(model.card, "Inputs"));
// What each symbol of the formulas stands for, from the card's "Where" list (issue #343).
const symbols = symbolsOf(model.card);
const outputs = variables(model.output_schema, cardOrder(model.card, "Outputs"));
// A family's calculations in words, beside their ids in the variables tables.
const calculationWords = new Map(calculations(model.input_schema).map((entry) => [entry.value, entry.label]));
const profiles = dataProfiles(model.bindings, conceptData, sourceData);
// What the page says when the hosted site may not serve some of the model's data (issue #320).
const notice = liveNotice(profiles);
const calculator = calculatorProps(model, surface, problemData, sourceData, conceptData);
// The package's install command, beside the calculator's Python and command-line snippets.
const install = prerelease(version) ? "pip install --pre pyeconomics" : "pip install pyeconomics";
// The room the loaded form takes, held before it loads so the page does not shift.
const room = formRoom(model, surface.profiles.length);
const topics = topicsOf(model.id, syllabusData);
const syllabi = syllabusData.filter((syllabus) => topics.some((entry) => entry.syllabus.id === syllabus.id));
const related = relatedModels(model, models, syllabusData);
const example = model.examples[0];
const result = model.example_result;
const hypothetical = simulates(model);
// The worked example as code, beside the surfaces' names (Phase 5 Step 17's round 0).
const exampleRun = { modelId: model.id, inputs: example?.inputs ?? {} };
const sectionClass = "model-section";
const headingClass = "section-title";
// The page's own contents, for the "On this page" list.
const contents = [
  { id: "formula", label: "Formula" },
  { id: "variables", label: "Variables" },
  { id: "calculator", label: "Calculator" },
  { id: "worked-example", label: "Worked example" },
  { id: "assumptions", label: "Assumptions" },
  { id: "limitations", label: "Limitations" },
  { id: "evidence", label: "Evidence" },
  { id: "syllabus", label: "Syllabus" },
  ...(profiles.length > 0 ? [{ id: "data", label: "Data" }] : []),
  { id: "citations", label: "Citations" },
  { id: "changelog", label: "Changelog" },
  ...(related.length > 0 ? [{ id: "related", label: "Related models" }] : []),
  { id: "use-it-elsewhere", label: "Use it elsewhere" },
];
const preClass = "code-box overflow-x-auto rounded-md px-4 py-3 text-sm";
---

<Base title={model.title} description={describe(model)} jsonLd={modelPage(model, path, trail)} searchable paintWith="formula">
  <Breadcrumbs trail={trail} />
  <div class="model-layout">
  <article class="model-article">
    <section id="summary" data-section="summary" class="model-head" aria-labelledby="model-title">
      <p class="eyebrow"><a href={domainPath(model.domain)}>{domainTitle(model.domain)}</a></p>
      <h1 id="model-title" class="page-title">{model.title}</h1>
      <p class="lead measure" data-pagefind-meta="summary">{model.summary}</p>
      <span hidden data-pagefind-meta="kind:Model"></span>
      <nav class="jump" aria-label="Jump to">
        <a href="#calculator" class="jump-primary">Run the calculator</a>
        <a href="#formula">Formula</a>
        <a href="#variables">Variables</a>
        <a href="#worked-example">Worked example</a>
        <a href="#citations">Citations</a>
      </nav>
      <dl class="facts">
        <dt class="text-muted-foreground">Model id</dt>
        <dd><code>{model.id}</code>, version {model.version}</dd>
        <dt class="text-muted-foreground">Domain</dt>
        <dd><a href={domainPath(model.domain)} data-pagefind-meta="domain">{domainTitle(model.domain)}</a></dd>
        <dt class="text-muted-foreground">Evidence</dt>
        <dd>{model.evidence ?? "not declared"}</dd>
        <dt class="text-muted-foreground">Cost class</dt>
        <dd>{model.cost ? `${model.cost}: ${COST_MEANING[model.cost]}` : "not declared"}</dd>
        {
          model.extra && (
            <Fragment>
              <dt class="text-muted-foreground">Needs</dt>
              <dd>
                <code>pip install "pyeconomics[{model.extra}]"</code>
              </dd>
            </Fragment>
          )
        }
      </dl>
    </section>

    <section id="formula" data-section="formula" class={sectionClass} aria-labelledby="formula-heading">
      <h2 id="formula-heading" class={headingClass}>Formula</h2>
      <div class="formula-plate">
        {model.formula.map((latex) => <Math latex={latex} display />)}
      </div>
      {
        symbols.length > 0 && (
          <div class="where" data-symbols>
            <h3 class="subsection-title">Where</h3>
            <dl class="symbols">
              {symbols.map((entry) => (
                <div data-symbol={entry.field ?? ""}>
                  <dt>
                    <Math latex={entry.symbol} />
                  </dt>
                  <dd>
                    {entry.field ? `${entry.meaning} ` : entry.meaning}
                    {entry.field && <code class="symbol-field">{entry.field}</code>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
      <p class="note measure">
        Each symbol's field is named beside it; the inputs and outputs, with their units and bounds, are under{" "}
        <a href="#variables">Variables</a>, and the <a href="#citations">citations</a> give each formula's source.
      </p>
    </section>

    <section id="variables" data-section="variables" class={sectionClass} aria-labelledby="variables-heading">
      <h2 id="variables-heading" class={headingClass}>Variables</h2>
      <p class="measure">
        Rates, returns and yields are decimals: 0.05 is five percent. Bounds in brackets include
        their end; in parentheses they exclude it.
      </p>
      <h3 class="subsection-title">Inputs</h3>
      {
        inputs.map((table, index) =>
          table.calculation ? (
            <details class="variables-group" open={index === 0}>
              <summary>
                {calculationWords.get(table.calculation) ?? table.calculation} (<code>{table.calculation}</code>):{" "}
                {table.rows.length} {table.rows.length === 1 ? "input" : "inputs"}
              </summary>
              <VariablesTable table={table} caption={`Inputs of the calculation ${table.calculation}`} />
            </details>
          ) : (
            <VariablesTable table={table} caption="Inputs" />
          ),
        )
      }
      <h3 class="subsection-title">Outputs</h3>
      {
        outputs.map((table, index) =>
          table.calculation ? (
            <details class="variables-group" open={index === 0}>
              <summary>
                {calculationWords.get(table.calculation) ?? table.calculation} (<code>{table.calculation}</code>):{" "}
                {table.rows.length} {table.rows.length === 1 ? "output" : "outputs"}
              </summary>
              <VariablesTable table={table} caption={`Outputs of the calculation ${table.calculation}`} />
            </details>
          ) : (
            <VariablesTable table={table} caption="Outputs" />
          ),
        )
      }
    </section>

    <section
      id="calculator"
      data-section="calculator"
      class={sectionClass}
      aria-labelledby="calculator-heading"
      data-pagefind-ignore="all"
    >
      <h2 id="calculator-heading" class={headingClass}>Calculator</h2>
      <p class="measure">
        Run the model on your own inputs, starting from its example. Rates are decimals: 0.05 is five percent. The run
        goes to the pyeconomics API on this site: your values travel only in the request, and nothing is stored.
      </p>
      {
        notice && (
          <div class="notice measure" data-library-only>
            <p class="font-medium">{notice.title}</p>
            {notice.served && <p class="mt-2" data-served-profiles>{notice.served}</p>}
            {notice.local.map((sentence) => <p class="mt-2" data-local-profiles>{sentence}</p>)}
            <p class="mt-2">
              {notice.served ? "For those" : "Here"}, enter your own values, or bring them as a file with "Use my own data".
              To run this page with every profile's live data, install the local app and start it:{" "}
              <code>{LOCAL_APP}</code>.
            </p>
          </div>
        )
      }
      <div class="calculator-card">
        <div class="calculator-slot">
          <Calculator client:visible {...calculator} install={install} />
        </div>
        <svg class="calculator-room calculator-room-narrow" aria-hidden="true" focusable="false" width="0" height={room.narrow}></svg>
        <svg class="calculator-room calculator-room-wide" aria-hidden="true" focusable="false" width="0" height={room.wide}></svg>
      </div>
      {hypothetical && <HypotheticalLegend model={model} place="calculator" />}
      <noscript>
        <p class="measure">
          The calculator needs JavaScript. The worked example below shows the model's inputs and outputs, and the
          REST API, the command line and the Python package run it too.
        </p>
      </noscript>
    </section>

    <section
      id="worked-example"
      data-section="worked-example"
      class={sectionClass}
      aria-labelledby="example-heading"
    >
      <h2 id="example-heading" class={headingClass}>Worked example</h2>
      {example?.note && <p class="measure">{example.note}</p>}
      <p>
        Example <code>{example?.name}</code>. Inputs:
      </p>
      <pre class={preClass} role="region" tabindex="0" aria-label="Example inputs"><code>{pretty(example?.inputs)}</code></pre>
      {
        result ? (
          <Fragment>
            <p>Outputs:</p>
            <pre class={preClass} role="region" tabindex="0" aria-label="Example outputs"><code>{pretty(result.outputs)}</code></pre>
            {hypothetical && <HypotheticalLegend model={model} place="worked-example" />}
            {result.warnings.length > 0 && (
              <Fragment>
                <p>Warnings:</p>
                <ul class="list-disc pl-6">
                  {result.warnings.map((warning) => (
                    <li>
                      <code>{warning.code}</code>: {warning.message}
                    </li>
                  ))}
                </ul>
              </Fragment>
            )}
          </Fragment>
        ) : (
          <p>
            The outputs are not shown here: the model needs the <code>{model.extra}</code> extra, which
            the build that wrote this page could not install.
          </p>
        )
      }
    </section>

    <section id="assumptions" data-section="assumptions" class={sectionClass} aria-labelledby="assumptions-heading">
      <h2 id="assumptions-heading" class={headingClass}>Assumptions</h2>
      {
        model.assumptions.length > 0 ? (
          <ul class="measure list-disc space-y-1 pl-6">
            {model.assumptions.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ) : (
          <p>None.</p>
        )
      }
    </section>

    <section id="limitations" data-section="limitations" class={sectionClass} aria-labelledby="limitations-heading">
      <h2 id="limitations-heading" class={headingClass}>Limitations</h2>
      {
        model.limitations.length > 0 ? (
          <ul class="measure list-disc space-y-1 pl-6">
            {model.limitations.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ) : (
          <p>None.</p>
        )
      }
    </section>

    <section id="evidence" data-section="evidence" class={sectionClass} aria-labelledby="evidence-heading">
      <h2 id="evidence-heading" class={headingClass}>Evidence</h2>
      <p class="measure">
        Status: <strong>{model.evidence ?? "not declared"}</strong>.{" "}
        {model.evidence && EVIDENCE_MEANING[model.evidence]}
      </p>
      <p class="note measure">
        Every model declares one status: standard (textbook consensus), practitioner (a widely used
        convention), contested (under active debate), rejected (failed out of sample) or historical (a
        superseded methodology).
      </p>
    </section>

    <section id="syllabus" data-section="syllabus" class={sectionClass} aria-labelledby="syllabus-heading">
      <h2 id="syllabus-heading" class={headingClass}>Syllabus</h2>
      {
        syllabi.length > 0 ? (
          syllabi.map((syllabus) => (
            <Fragment>
              <p class="measure">
                The {syllabus.title}'s topic areas this model relates to, as factual tags. Each links
                to {syllabus.issuer}'s page for its level; pyeconomics holds none of the curriculum's text.
              </p>
              <ul class="measure space-y-1">
                {topics
                  .filter((entry) => entry.syllabus.id === syllabus.id)
                  .map(({ level, topic }) => (
                    <li data-topic={topic.id}>
                      <a href={topic.url}>
                        {level.title}: {topic.title}
                      </a>{" "}
                      <span class="text-sm text-muted-foreground">
                        (<a href={`/models/?topic=${topic.id}`}>models for this topic area</a>)
                      </span>
                    </li>
                  ))}
              </ul>
            </Fragment>
          ))
        ) : (
          <p class="measure">
            No syllabus topic is mapped to this model yet. The <a href="/coverage/">coverage matrix</a> shows what is
            mapped.
          </p>
        )
      }
    </section>

    {
      profiles.length > 0 && (
        <section id="data" data-section="data" class={sectionClass} aria-labelledby="data-heading">
          <h2 id="data-heading" class={headingClass}>
            Data
          </h2>
          <p class="measure">
            This model can read its data for you: each bound field names a data series, and the sources listed can
            fill it, in the order they are tried. This website reads only the sources whose terms let it serve their
            data (marked "hosted"); every source is available when you run pyeconomics on your own computer.
          </p>
          {profiles.map((profile) => (
            <div class="overflow-x-auto" role="region" aria-label={`Profile ${profile.profile}`} tabindex="0">
              <table class="w-full border-collapse text-left text-sm">
                <caption class="mb-2 text-left font-medium">
                  Profile: {profileName(profile.profile)}
                  {profileLabel(profile.profile) !== profileName(profile.profile) && (
                    <Fragment>
                      {" "}
                      (<code>{profile.profile}</code>)
                    </Fragment>
                  )}
                </caption>
                <thead>
                  <tr class="border-b">
                    <th scope="col" class="py-2 pr-4">
                      Field
                    </th>
                    <th scope="col" class="min-w-40 py-2 pr-4">
                      Concept
                    </th>
                    <th scope="col" class="min-w-48 py-2 pr-4">
                      Read as
                    </th>
                    <th scope="col" class="min-w-56 py-2">
                      Sources (licence class; hosted)
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {profile.rows.map((row) => (
                    <tr class="border-b align-top">
                      <th scope="row" class="py-2 pr-4 font-normal">
                        <code>{row.field}</code>
                        {row.shape && <span class="block text-muted-foreground">{row.shape}</span>}
                      </th>
                      <td class="py-2 pr-4">
                        <a href={conceptPath(row.concept)}>{row.conceptTitle}</a>
                        <span class="block text-muted-foreground">
                          <code>{row.concept}</code>
                        </span>
                      </td>
                      <td class="py-2 pr-4">
                        {row.rule}; {row.vintage}
                        {row.transform && (
                          <span class="block">
                            transform <code>{row.transform}</code>
                          </span>
                        )}
                      </td>
                      <td class="py-2">
                        <ul>
                          {row.sources.map((source) => (
                            <li>
                              {source.name} ({source.licence}; {source.hosted ? "hosted" : "not hosted"})
                            </li>
                          ))}
                        </ul>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </section>
      )
    }

    <section id="citations" data-section="citations" class={sectionClass} aria-labelledby="citations-heading">
      <h2 id="citations-heading" class={headingClass}>Citations</h2>
      <ol class="measure list-decimal space-y-2 pl-6">
        {
          model.references.map((reference) => {
            const link = referenceLink(reference);
            return (
              <li>
                {reference.citation}
                {link && (
                  <Fragment>
                    {" "}
                    <a href={link}>
                      {reference.doi ? `doi:${reference.doi}` : link}
                    </a>
                  </Fragment>
                )}
                {reference.locator && <Fragment> ({reference.locator})</Fragment>}
                {reference.isbn && <Fragment>. ISBN {reference.isbn}</Fragment>}
              </li>
            );
          })
        }
      </ol>
    </section>

    <section id="changelog" data-section="changelog" class={sectionClass} aria-labelledby="changelog-heading">
      <h2 id="changelog-heading" class={headingClass}>Changelog</h2>
      <ul class="measure list-disc space-y-1 pl-6">
        {
          model.changelog.map((entry) => (
            <li>
              Version {entry.version}: {entry.note}
            </li>
          ))
        }
      </ul>
    </section>

    {
      related.length > 0 && (
        <section id="related" data-section="related" class={sectionClass} aria-labelledby="related-heading">
          <h2 id="related-heading" class={headingClass}>
            Related models
          </h2>
          <ul class="related-grid">
            {related.map((other) => (
              <li class="card" data-related={other.id}>
                <a href={modelPath(other.id)} class="font-medium">
                  {other.title}
                </a>
                <span class="block text-sm text-muted-foreground">{describe(other, 110)}</span>
                {other.domain !== model.domain && (
                  <span class="block text-xs text-muted-foreground">{domainTitle(other.domain)}</span>
                )}
              </li>
            ))}
          </ul>
          <p class="mt-4">
            <a href={domainPath(model.domain)} data-related-domain>
              Every {domainTitle(model.domain)} model
            </a>
          </p>
        </section>
      )
    }

    <section id="use-it-elsewhere" data-section="use-it-elsewhere" class={sectionClass} aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading" class={headingClass}>Use it elsewhere</h2>
      <dl class="elsewhere">
        <dt class="font-medium">Documentation</dt>
        <dd><a href={docsUrl(model.id)}>The model's reference page</a></dd>
        <dt class="font-medium">REST API</dt>
        <dd><code>{surface.methods.join(" or ")} {surface.rest}</code></dd>
        {
          surface.mcp_tool && (
            <Fragment>
              <dt class="font-medium">MCP tool</dt>
              <dd>
                <code>{surface.mcp_tool}</code>, or <code>run_model</code> with the model's id; both give the same
                result. <a href="/assistants/">Connect an assistant</a>
              </dd>
            </Fragment>
          )
        }
        {
          !surface.mcp_tool && (
            <Fragment>
              <dt class="font-medium">MCP tool</dt>
              <dd>
                <code>run_model</code> with the model's id, <code>{model.id}</code>.{" "}
                <a href="/assistants/">Connect an assistant</a>
              </dd>
            </Fragment>
          )
        }
        <dt class="font-medium">Command line</dt>
        <dd><code>{surface.cli} --help</code></dd>
      </dl>
      <p class="measure">The worked example, from Python and from the command line:</p>
      <div class="code-grid">
        <figure class="code-block">
          <figcaption>Python</figcaption>
          <pre role="region" tabindex="0" aria-label="The worked example in Python"><code>{pythonSnippet(exampleRun)}</code></pre>
        </figure>
        <figure class="code-block">
          <figcaption>Command line</figcaption>
          <pre role="region" tabindex="0" aria-label="The worked example on the command line"><code>{cliSnippet(exampleRun)}</code></pre>
        </figure>
      </div>
    </section>
  </article>
  <aside class="toc" aria-labelledby="toc-heading" data-pagefind-ignore="all">
    <nav aria-labelledby="toc-heading">
      <p id="toc-heading" class="toc-heading">On this page</p>
      <ul>
        {contents.map((entry) => <li><a href={`#${entry.id}`}>{entry.label}</a></li>)}
      </ul>
    </nav>
  </aside>
  </div>
</Base>
