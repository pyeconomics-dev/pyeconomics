---
// web/src/layouts/Base.astro
// The layout every page uses: one stylesheet, the header, a main landmark the
// skip link targets, and the footer with the notices. It loads no script and
// no web font; Astro adds each page's Content Security Policy as a <meta>
// element, and dist/_headers sends the same policy as a header. Each page gets
// a canonical link on the production origin, Open Graph and Twitter card tags
// with the social image drawn for it at build time (src/pages/og/), and the
// page's schema.org JSON-LD, if it has any, in a script no browser executes.
// The 404 page is neither canonical nor indexable. A page whose content
// search should find (`searchable`: model, domain and problem pages; Step 16
// adds the source and legal pages) marks its main landmark data-pagefind-body,
// and Pagefind indexes only such pages (scripts/search-index.ts), so the
// header and footer, the home page, /search/ and the 404 page stay out.
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { ORIGIN } from "@/lib/models";
import { ogImagePath } from "@/lib/pages";
import { jsonLdText } from "@/lib/structured-data";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for the page. */
  jsonLd?: Record<string, unknown>;
  /** A page that must not be indexed and has no canonical address (the 404 page). */
  noindex?: boolean;
  /** A page the site's search indexes. */
  searchable?: boolean;
}

const { title, description, jsonLd, noindex = false, searchable = false } = Astro.props;
const pageTitle = title === "pyeconomics" ? title : `${title} · pyeconomics`;
const canonical = new URL(Astro.url.pathname, ORIGIN).href;
const image = new URL(ogImagePath(Astro.url.pathname), ORIGIN).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    {
      !noindex && (
        <Fragment>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="pyeconomics" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={image} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={image} />
        </Fragment>
      )
    }
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-background px-4 py-2 focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full max-w-5xl flex-1 px-4 py-10"
      data-pagefind-body={searchable ? "" : undefined}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
