{
  "name": "pyeconomics-web",
  "version": "0.0.0",
  "private": true,
  "description": "The pyeconomics web app: a static Astro site with React islands, built from the registry and catalog export (ADR-0006, ADR-0013).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "data": "uv run --project .. --locked --all-extras python ../scripts/web/export_site_data.py && openapi-ts",
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "build": "node scripts/require-data.ts && astro build && node scripts/headers.ts",
    "serve": "wrangler dev --ip 127.0.0.1 --port 8788",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.ts",
    "licences": "uv run --project .. --locked python ../scripts/checks/web_licences.py"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.2",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.4",
    "chrome-launcher": "1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "katex": "0.19.1",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
