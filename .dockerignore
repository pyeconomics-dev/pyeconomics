# .dockerignore

# Version control and CI
.git
.git/
.gitignore
.gitattributes
.github/
.pre-commit-config.yaml
.semgrep/

# Secrets and local environment files (never enter the build context)
.env
.env.*
**/.env
**/.env.*
secrets.py
**/secrets.py
*.pem
*.key

# Private agent context, memory and personal posture
.agents/
.claude/
**/.claude/
.codex/
.cursor/
.gemini/
.roadmodel/
AGENTS.md
AGENTS.override.md
CLAUDE.md
CLAUDE.local.md
CONTRIBUTING.md
CHANGELOG.md
SECURITY.md
planning/
planning/user-context.md

# Local working directories and caches (anchored so src/pyeconomics/data/cache/ stays)
dev/
/cache/
!src/pyeconomics/data/cache/
.worktrees/

# Python bytecode, virtual environments and build artefacts
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*.egg-info/
**/*.egg-info/
.eggs/
.venv/
venv/
dist/
dist-app/
build/

# Tool caches and coverage reports
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.benchmarks/
.wrangler/
htmlcov/
.coverage*
coverage.xml
coverage.json

# Documentation, tests, scripts, Node tooling and the web app
docs/
docs/_build/
docs/study-paths/
docs/gallery/
docs/reference/models/
docs/reference/providers/
docs/reference/concepts/
docs/reference/sources.md
docs/problems.md
docs/autoapi/
docs/.jupyter_cache/
/site/
site/
tests/
scripts/
tools/
web/
# The web app's local output, already inside web/ above; listed so this file
# covers every .gitignore rule (tests/server/test_container.py).
web/node_modules/
web/dist/
web/.astro/
web/src/data/generated/
web/src/client/
web/playwright-report/
web/test-results/
web/.lighthouse/
# The web app's wheel (Phase 5 Step 10): the service never serves the site
# (Cloudflare does), so the workspace member stays out of the build context;
# uv export --frozen and uv build at the root need only the root's files.
packages/
packages/pyeconomics-app/src/pyeconomics_app/site/
Dockerfile
.dockerignore
pylock.toml

# Local maintainer scripts
generate_tests.py
render_readme.py
output.html

# Editors, notebooks and operating systems
.idea/
.vscode/
*.swp
**/*.swp
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
