{
  "$defs": {
    "BaxterKingOutputs": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "const": "baxter_king",
          "default": "baxter_king",
          "description": "The Baxter-King (1999) band-pass filter",
          "title": "Calculation",
          "type": "string"
        },
        "cycle": {
          "description": "The gap in each period, in the stated form",
          "items": {
            "maximum": 1000000.0,
            "minimum": -100.0,
            "type": "number",
            "x-unit": "rate"
          },
          "maxItems": 2000,
          "title": "Cycle",
          "type": "array"
        },
        "gap": {
          "description": "The gap in the last period the cycle covers",
          "maximum": 1000000.0,
          "minimum": -100.0,
          "title": "Gap",
          "type": "number",
          "x-unit": "rate"
        },
        "high": {
          "description": "The band's high end",
          "maximum": 1000.0,
          "minimum": 2.0,
          "title": "High",
          "type": "number",
          "x-unit": "periods"
        },
        "lead_lag": {
          "description": "The K it used",
          "maximum": 1000,
          "minimum": 1,
          "title": "Lead Lag",
          "type": "integer",
          "x-unit": "count"
        },
        "low": {
          "description": "The band's low end",
          "maximum": 1000.0,
          "minimum": 2.0,
          "title": "Low",
          "type": "number",
          "x-unit": "periods"
        },
        "start": {
          "description": "The position in the series (from 0) of the first period the trend and cycle cover",
          "maximum": 2000,
          "minimum": 0,
          "title": "Start",
          "type": "integer",
          "x-unit": "count"
        },
        "trend": {
          "description": "The trend (potential output) in each period the cycle covers, in the series' units",
          "items": {
            "exclusiveMinimum": 0,
            "maximum": 1e+18,
            "type": "number",
            "x-unit": "money"
          },
          "maxItems": 2000,
          "title": "Trend",
          "type": "array"
        }
      },
      "required": [
        "trend",
        "cycle",
        "gap",
        "start",
        "low",
        "high",
        "lead_lag"
      ],
      "title": "BaxterKingOutputs",
      "type": "object"
    },
