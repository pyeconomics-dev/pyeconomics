{
  "$defs": {
    "Alternative": {
      "enum": [
        "two_sided",
        "less",
        "greater"
      ],
      "type": "string"
    },
    "ChiSquareVarianceInputs": {
      "additionalProperties": false,
      "description": "A sample's size and standard deviation, and the hypothesized one.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Significance level",
          "maximum": 0.5,
          "minimum": 0.0001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "alternative": {
          "$ref": "#/$defs/Alternative",
          "default": "two_sided",
          "description": "The alternative hypothesis"
        },
        "calculation": {
          "const": "chi_square_variance",
          "default": "chi_square_variance",
          "description": "Chi-square test of a variance",
          "title": "Calculation",
          "type": "string"
        },
        "hypothesized_sd": {
          "description": "Standard deviation under the null hypothesis",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Hypothesized Sd",
          "type": "number",
          "x-unit": "ratio"
        },
        "n": {
          "description": "Sample size",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N",
          "type": "integer",
          "x-unit": "count"
        },
        "sd": {
          "description": "Sample standard deviation (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "n",
        "sd",
        "hypothesized_sd"
      ],
      "title": "ChiSquareVarianceInputs",
      "type": "object"
    },
    "FVariancesInputs": {
      "additionalProperties": false,
      "description": "Two independent samples' sizes and standard deviations.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Significance level",
          "maximum": 0.5,
          "minimum": 0.0001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "alternative": {
          "$ref": "#/$defs/Alternative",
          "default": "two_sided",
          "description": "The alternative hypothesis"
        },
        "calculation": {
          "const": "f_variances",
          "default": "f_variances",
          "description": "F test of the ratio of two variances",
          "title": "Calculation",
          "type": "string"
        },
        "n1": {
          "description": "First sample size",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N1",
          "type": "integer",
          "x-unit": "count"
        },
        "n2": {
          "description": "Second sample size",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N2",
          "type": "integer",
          "x-unit": "count"
        },
        "sd1": {
          "description": "First sample standard deviation (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd1",
          "type": "number",
          "x-unit": "ratio"
        },
        "sd2": {
          "description": "Second sample standard deviation (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd2",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "n1",
        "sd1",
        "n2",
        "sd2"
      ],
      "title": "FVariancesInputs",
      "type": "object"
    },
    "OneSampleTInputs": {
      "additionalProperties": false,
      "description": "One sample's size, mean and standard deviation.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Significance level",
          "maximum": 0.5,
          "minimum": 0.0001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "alternative": {
          "$ref": "#/$defs/Alternative",
          "default": "two_sided",
          "description": "The alternative hypothesis"
        },
        "calculation": {
          "const": "one_sample_t",
          "default": "one_sample_t",
          "description": "One-sample t test of a mean",
          "title": "Calculation",
          "type": "string"
        },
        "hypothesized_mean": {
          "default": 0.0,
          "description": "Mean under the null hypothesis",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Hypothesized Mean",
          "type": "number",
          "x-unit": "ratio"
        },
        "mean": {
          "description": "Sample mean",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Mean",
          "type": "number",
          "x-unit": "ratio"
        },
        "n": {
          "description": "Sample size",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N",
          "type": "integer",
          "x-unit": "count"
        },
        "sd": {
          "description": "Sample standard deviation (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "n",
        "mean",
        "sd"
      ],
      "title": "OneSampleTInputs",
      "type": "object"
    },
    "PairedTInputs": {
      "additionalProperties": false,
      "description": "The size, mean and standard deviation of paired differences.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Significance level",
          "maximum": 0.5,
          "minimum": 0.0001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "alternative": {
          "$ref": "#/$defs/Alternative",
          "default": "two_sided",
          "description": "The alternative hypothesis"
        },
        "calculation": {
          "const": "paired_t",
          "default": "paired_t",
          "description": "Paired t test of a mean difference",
          "title": "Calculation",
          "type": "string"
        },
        "hypothesized_difference": {
          "default": 0.0,
          "description": "Mean difference under the null hypothesis",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Hypothesized Difference",
          "type": "number",
          "x-unit": "ratio"
        },
        "mean_difference": {
          "description": "Mean of the differences",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Mean Difference",
          "type": "number",
          "x-unit": "ratio"
        },
        "n": {
          "description": "Number of pairs",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N",
          "type": "integer",
          "x-unit": "count"
        },
        "sd_difference": {
          "description": "Standard deviation of the differences (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd Difference",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "n",
        "mean_difference",
        "sd_difference"
      ],
      "title": "PairedTInputs",
      "type": "object"
    },
    "TwoSampleTInputs": {
      "additionalProperties": false,
      "description": "Two independent samples' sizes, means and standard deviations.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Significance level",
          "maximum": 0.5,
          "minimum": 0.0001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "alternative": {
          "$ref": "#/$defs/Alternative",
          "default": "two_sided",
          "description": "The alternative hypothesis"
        },
        "calculation": {
          "const": "two_sample_t",
          "default": "two_sample_t",
          "description": "Two-sample t test of a difference in means",
          "title": "Calculation",
          "type": "string"
        },
        "equal_variances": {
          "default": true,
          "description": "Pool the variances (Student); false for Welch's test",
          "title": "Equal Variances",
          "type": "boolean"
        },
        "hypothesized_difference": {
          "default": 0.0,
          "description": "mean1 - mean2 under the null hypothesis",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Hypothesized Difference",
          "type": "number",
          "x-unit": "ratio"
        },
        "mean1": {
          "description": "First sample mean",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Mean1",
          "type": "number",
          "x-unit": "ratio"
        },
        "mean2": {
          "description": "Second sample mean",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Mean2",
          "type": "number",
          "x-unit": "ratio"
        },
        "n1": {
          "description": "First sample size",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N1",
          "type": "integer",
          "x-unit": "count"
        },
        "n2": {
          "description": "Second sample size",
          "maximum": 1000000,
          "minimum": 2,
          "title": "N2",
          "type": "integer",
          "x-unit": "count"
        },
        "sd1": {
          "description": "First sample standard deviation (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd1",
          "type": "number",
          "x-unit": "ratio"
        },
        "sd2": {
          "description": "Second sample standard deviation (n - 1)",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sd2",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "n1",
        "mean1",
        "sd1",
        "n2",
        "mean2",
        "sd2"
      ],
      "title": "TwoSampleTInputs",
      "type": "object"
    },
    "ZMeanInputs": {
      "additionalProperties": false,
      "description": "A sample mean, its size, and the known population standard deviation.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Significance level",
          "maximum": 0.5,
          "minimum": 0.0001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "alternative": {
          "$ref": "#/$defs/Alternative",
          "default": "two_sided",
          "description": "The alternative hypothesis"
        },
        "calculation": {
          "const": "z_mean",
          "default": "z_mean",
          "description": "z test of a mean with known sigma",
          "title": "Calculation",
          "type": "string"
        },
        "hypothesized_mean": {
          "default": 0.0,
          "description": "Mean under the null hypothesis",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Hypothesized Mean",
          "type": "number",
          "x-unit": "ratio"
        },
        "mean": {
          "description": "Sample mean",
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Mean",
          "type": "number",
          "x-unit": "ratio"
        },
        "n": {
          "description": "Sample size",
          "maximum": 1000000,
          "minimum": 1,
          "title": "N",
          "type": "integer",
          "x-unit": "count"
        },
        "sigma": {
          "description": "Known population standard deviation",
          "maximum": 10000.0,
          "minimum": 0.0001,
          "title": "Sigma",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "n",
        "mean",
        "sigma"
      ],
      "title": "ZMeanInputs",
      "type": "object"
    }
  },
  "$id": "urn:pyeconomics:model:foundations.hypothesis_tests:1:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One-sample, two-sample (pooled and Welch) and paired t tests, the z test, and chi-square and F tests of variances, with p-values, critical values and confidence intervals.",
  "discriminator": {
    "mapping": {
      "chi_square_variance": "#/$defs/ChiSquareVarianceInputs",
      "f_variances": "#/$defs/FVariancesInputs",
      "one_sample_t": "#/$defs/OneSampleTInputs",
      "paired_t": "#/$defs/PairedTInputs",
      "two_sample_t": "#/$defs/TwoSampleTInputs",
      "z_mean": "#/$defs/ZMeanInputs"
    },
    "propertyName": "calculation"
  },
  "examples": [
    {
      "alpha": 0.05,
      "alternative": "two_sided",
      "calculation": "one_sample_t",
      "hypothesized_mean": 5.0,
      "mean": 9.26146,
      "n": 195,
      "sd": 0.022789
    },
    {
      "alpha": 0.05,
      "alternative": "two_sided",
      "calculation": "two_sample_t",
      "equal_variances": true,
      "hypothesized_difference": 0.0,
      "mean1": 20.14458,
      "mean2": 30.48101,
      "n1": 249,
      "n2": 79,
      "sd1": 6.4147,
      "sd2": 6.10771
    },
    {
      "alpha": 0.05,
      "alternative": "two_sided",
      "calculation": "paired_t",
      "hypothesized_difference": 0.0,
      "mean_difference": 1.2,
      "n": 10,
      "sd_difference": 2.1
    },
    {
      "alpha": 0.05,
      "alternative": "two_sided",
      "calculation": "z_mean",
      "hypothesized_mean": 100.0,
      "mean": 102.0,
      "n": 36,
      "sigma": 6.0
    },
    {
      "alpha": 0.05,
      "alternative": "two_sided",
      "calculation": "chi_square_variance",
      "hypothesized_sd": 0.1,
      "n": 100,
      "sd": 0.0063
    },
    {
      "alpha": 0.05,
      "alternative": "two_sided",
      "calculation": "f_variances",
      "n1": 240,
      "n2": 240,
      "sd1": 65.54909,
      "sd2": 61.85425
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/OneSampleTInputs"
    },
    {
      "$ref": "#/$defs/TwoSampleTInputs"
    },
    {
      "$ref": "#/$defs/PairedTInputs"
    },
    {
      "$ref": "#/$defs/ZMeanInputs"
    },
    {
      "$ref": "#/$defs/ChiSquareVarianceInputs"
    },
    {
      "$ref": "#/$defs/FVariancesInputs"
    }
  ],
  "title": "Hypothesis tests from summary statistics: inputs"
}
