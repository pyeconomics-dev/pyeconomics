          "description": "Days from settlement to maturity",
          "maximum": 366,
          "minimum": 1,
          "title": "Days",
          "type": "integer",
          "x-unit": "days"
        },
        "days_in_year": {
          "default": 365,
          "description": "Days in the year after the issue date: 366 when it holds a February 29",
          "maximum": 366,
          "minimum": 365,
          "title": "Days In Year",
          "type": "integer",
          "x-unit": "days"
        },
        "face_value": {
          "default": 100.0,
          "description": "Face value repaid at maturity",
