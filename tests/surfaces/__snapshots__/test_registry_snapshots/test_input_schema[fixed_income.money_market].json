          "description": "Money-market (CD-equivalent) yield",
          "title": "Calculation",
          "type": "string"
        },
        "days": {
          "description": "Days from settlement to maturity",
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer",
          "x-unit": "days"
        },
        "face_value": {
          "default": 100.0,
          "description": "Face value repaid at maturity",
          "maximum": 1000000000000.0,
          "minimum": 0.01,
          "title": "Face Value",
          "type": "number",
          "x-unit": "money"
        },
        "price": {
          "description": "Price paid for the face value",
          "exclusiveMinimum": 0.0,
          "maximum": 1000000000000.0,
          "title": "Price",
          "type": "number",
          "x-unit": "money"
        }
      },
      "required": [
        "price",
        "days"
      ],
      "title": "MoneyMarketYieldInputs",
      "type": "object"
    },
    "PriceFromDiscountInputs": {
      "additionalProperties": false,
      "description": "A bank discount rate and the days to maturity.",
      "properties": {
        "calculation": {
          "const": "price_from_discount",
          "default": "price_from_discount",
          "description": "Price from a bank discount rate",
          "title": "Calculation",
          "type": "string"
        },
        "days": {
          "description": "Days from settlement to maturity",
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer",
          "x-unit": "days"
        },
        "discount_rate": {
          "description": "Bank discount rate, per 360 days",
          "maximum": 1.0,
          "minimum": -0.5,
          "title": "Discount Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "face_value": {
          "default": 100.0,
          "description": "Face value repaid at maturity",
          "maximum": 1000000000000.0,
          "minimum": 0.01,
