{
  "$defs": {
    "DiscountFromPriceInputs": {
      "additionalProperties": false,
      "description": "A price and the days to maturity.",
      "properties": {
        "calculation": {
          "const": "discount_from_price",
          "default": "discount_from_price",
          "description": "Bank discount rate from a price",
          "title": "Calculation",
          "type": "string"
        },
        "days": {
          "description": "Days from settlement to maturity",
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer",
          "x-unit": "days"
        },
        "face_value": {
          "default": 100.0,
          "description": "Face value repaid at maturity",
          "maximum": 1000000000000.0,
          "minimum": 0.01,
          "title": "Face Value",
          "type": "number",
          "x-unit": "money"
        },
        "price": {
          "description": "Price paid for the face value",
          "exclusiveMinimum": 0.0,
          "maximum": 1000000000000.0,
          "title": "Price",
          "type": "number",
          "x-unit": "money"
        }
      },
      "required": [
        "price",
        "days"
      ],
      "title": "DiscountFromPriceInputs",
      "type": "object"
    },
    "EffectiveAnnualYieldInputs": {
      "additionalProperties": false,
      "description": "A price and the days to maturity.",
