        "calculation": {
          "const": "effective_annual_yield",
          "default": "effective_annual_yield",
          "description": "Return compounded to a 365-day year",
          "title": "Calculation",
          "type": "string"
        },
        "days": {
          "description": "Days from settlement to maturity",
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer",
          "x-unit": "days"
        },
        "face_value": {
          "default": 100.0,
          "description": "Face value repaid at maturity",
          "maximum": 1000000000000.0,
          "minimum": 0.01,
          "title": "Face Value",
          "type": "number",
          "x-unit": "money"
        },
        "price": {
          "description": "Price paid for the face value",
          "exclusiveMinimum": 0.0,
          "maximum": 1000000000000.0,
          "title": "Price",
          "type": "number",
          "x-unit": "money"
        }
      },
      "required": [
        "price",
        "days"
      ],
      "title": "EffectiveAnnualYieldInputs",
      "type": "object"
    },
    "HoldingPeriodYieldInputs": {
      "additionalProperties": false,
      "description": "What was paid, what was received, and any income.",
      "properties": {
        "calculation": {
          "const": "holding_period_yield",
          "default": "holding_period_yield",
          "description": "Return over the holding period",
          "title": "Calculation",
          "type": "string"
        },
        "income": {
          "default": 0.0,
          "description": "Interest or other income received",
          "maximum": 1000000000000.0,
          "minimum": 0.0,
          "title": "Income",
          "type": "number",
          "x-unit": "money"
        },
        "proceeds": {
          "description": "Sale price, or the face value repaid at maturity",
          "maximum": 1000000000000.0,
          "minimum": 0.0,
          "title": "Proceeds",
          "type": "number",
          "x-unit": "money"
        },
        "purchase_price": {
          "description": "Price paid at the start",
          "exclusiveMinimum": 0.0,
          "maximum": 1000000000000.0,
          "title": "Purchase Price",
          "type": "number",
          "x-unit": "money"
        }
      },
      "required": [
        "purchase_price",
        "proceeds"
      ],
      "title": "HoldingPeriodYieldInputs",
      "type": "object"
    },
    "InvestmentRateInputs": {
