{
  "$defs": {
    "Black76ImpliedInputs": {
      "additionalProperties": false,
      "description": "A European option on a futures price, and its price.",
      "properties": {
        "calculation": {
          "const": "black_76_implied_volatility",
          "default": "black_76_implied_volatility",
          "description": "Volatility implied by a Black-76 price",
          "title": "Calculation",
          "type": "string"
        },
        "futures_price": {
          "description": "Futures or forward price for delivery at expiry",
          "maximum": 10000000.0,
          "minimum": 0.01,
          "title": "Futures Price",
          "type": "number",
          "x-unit": "money"
        },
        "option_price": {
          "description": "The option's price",
          "maximum": 1000000000000.0,
          "minimum": 0.0,
          "title": "Option Price",
          "type": "number",
          "x-unit": "money"
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "default": "call",
          "description": "A call (the right to buy) or a put (to sell)"
        },
        "risk_free_rate": {
          "description": "Risk-free rate per year, continuously compounded",
          "maximum": 1.0,
          "minimum": -0.1,
          "title": "Risk Free Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "strike": {
          "description": "Strike price",
          "maximum": 10000000.0,
          "minimum": 0.01,
          "title": "Strike",
          "type": "number",
          "x-unit": "money"
        },
        "years": {
          "description": "Time to expiry, in years",
          "maximum": 100.0,
          "minimum": 0.001,
          "title": "Years",
          "type": "number",
          "x-unit": "years"
        }
      },
      "required": [
        "futures_price",
        "strike",
        "years",
        "risk_free_rate",
        "option_price"
      ],
      "title": "Black76ImpliedInputs",
      "type": "object"
    },
    "Black76Inputs": {
