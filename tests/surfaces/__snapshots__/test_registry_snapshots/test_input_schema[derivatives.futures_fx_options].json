  "$id": "urn:pyeconomics:model:derivatives.futures_fx_options:1:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Black-76 prices of options on futures and Garman-Kohlhagen prices of currency options, with Greeks and implied volatilities.",
  "discriminator": {
    "mapping": {
      "black_76": "#/$defs/Black76Inputs",
      "black_76_implied_volatility": "#/$defs/Black76ImpliedInputs",
      "garman_kohlhagen": "#/$defs/GarmanKohlhagenInputs",
      "garman_kohlhagen_implied_volatility": "#/$defs/GarmanKohlhagenImpliedInputs"
    },
    "propertyName": "calculation"
  },
  "examples": [
    {
      "calculation": "black_76",
      "futures_price": 20.0,
      "option_type": "put",
      "risk_free_rate": 0.09,
      "strike": 20.0,
      "volatility": 0.25,
      "years": 0.3333
    },
    {
      "calculation": "black_76_implied_volatility",
      "futures_price": 19.0,
      "option_price": 1.7011,
      "option_type": "call",
      "risk_free_rate": 0.1,
      "strike": 19.0,
      "years": 0.75
    },
    {
      "calculation": "garman_kohlhagen",
      "domestic_rate": 0.045,
      "foreign_rate": 0.03,
      "option_type": "call",
      "spot": 1.08,
      "strike": 1.1,
      "volatility": 0.08,
      "years": 0.5
    },
    {
      "calculation": "garman_kohlhagen_implied_volatility",
      "domestic_rate": 0.045,
      "foreign_rate": 0.03,
      "option_price": 0.02,
      "option_type": "put",
      "spot": 1.08,
      "strike": 1.1,
      "years": 0.5
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/Black76Inputs"
    },
    {
      "$ref": "#/$defs/Black76ImpliedInputs"
    },
    {
      "$ref": "#/$defs/GarmanKohlhagenInputs"
    },
    {
      "$ref": "#/$defs/GarmanKohlhagenImpliedInputs"
    }
  ],
  "title": "Futures and currency options: inputs"
