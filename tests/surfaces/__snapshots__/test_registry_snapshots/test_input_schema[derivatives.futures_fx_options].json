          "description": "A call (the right to buy) or a put (to sell)"
        },
        "spot": {
          "description": "Spot exchange rate, in units of the quote (domestic) currency per unit of the base (foreign) currency",
          "maximum": 1000000.0,
          "minimum": 0.0001,
          "title": "Spot",
          "type": "number",
          "x-unit": "ratio"
        },
        "strike": {
          "description": "Strike exchange rate, in units of the quote (domestic) currency per unit of the base (foreign) currency",
          "maximum": 1000000.0,
          "minimum": 0.0001,
          "title": "Strike",
          "type": "number",
          "x-unit": "ratio"
        },
        "volatility": {
          "description": "Volatility of the exchange rate per year",
          "maximum": 5.0,
          "minimum": 0.001,
          "title": "Volatility",
