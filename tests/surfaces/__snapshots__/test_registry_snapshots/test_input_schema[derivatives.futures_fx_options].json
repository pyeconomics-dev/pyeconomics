    "GarmanKohlhagenImpliedInputs": {
      "additionalProperties": false,
      "description": "A European currency option, and its price.",
      "properties": {
        "calculation": {
          "const": "garman_kohlhagen_implied_volatility",
          "default": "garman_kohlhagen_implied_volatility",
          "description": "Volatility implied by a Garman-Kohlhagen price",
          "title": "Calculation",
          "type": "string"
        },
        "domestic_rate": {
          "description": "Interest rate of the quote (domestic) currency, continuously compounded",
          "maximum": 1.0,
          "minimum": -0.1,
          "title": "Domestic Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "foreign_rate": {
          "description": "Interest rate of the base (foreign) currency, continuously compounded",
          "maximum": 1.0,
          "minimum": -0.1,
          "title": "Foreign Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "option_price": {
          "description": "The option's price, in the quote currency per unit of base",
          "maximum": 1000000000000.0,
          "minimum": 0.0,
          "title": "Option Price",
          "type": "number",
          "x-unit": "money"
        },
        "option_type": {
          "$ref": "#/$defs/OptionType",
          "default": "call",
          "description": "A call (the right to buy) or a put (to sell)"
        },
        "spot": {
          "description": "Spot exchange rate, in units of the quote (domestic) currency per unit of the base (foreign) currency",
          "maximum": 1000000.0,
          "minimum": 0.0001,
          "title": "Spot",
          "type": "number",
          "x-unit": "ratio"
        },
        "strike": {
          "description": "Strike exchange rate, in units of the quote (domestic) currency per unit of the base (foreign) currency",
          "maximum": 1000000.0,
          "minimum": 0.0001,
          "title": "Strike",
          "type": "number",
          "x-unit": "ratio"
        },
        "years": {
          "description": "Time to expiry, in years",
          "maximum": 100.0,
          "minimum": 0.001,
          "title": "Years",
          "type": "number",
          "x-unit": "years"
        }
      },
      "required": [
        "spot",
        "strike",
        "years",
        "domestic_rate",
        "foreign_rate",
        "option_price"
      ],
      "title": "GarmanKohlhagenImpliedInputs",
      "type": "object"
    },
