        "risk_free_rate": {
          "description": "Risk-free rate per year, continuously compounded",
          "maximum": 1.0,
          "minimum": -0.1,
          "title": "Risk Free Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "strike": {
          "description": "Strike price",
          "maximum": 10000000.0,
          "minimum": 0.01,
          "title": "Strike",
          "type": "number",
          "x-unit": "money"
        },
        "volatility": {
          "description": "Volatility of the futures price per year",
          "maximum": 5.0,
          "minimum": 0.001,
          "title": "Volatility",
          "type": "number",
          "x-unit": "volatility"
        },
        "years": {
          "description": "Time to expiry, in years",
          "maximum": 100.0,
