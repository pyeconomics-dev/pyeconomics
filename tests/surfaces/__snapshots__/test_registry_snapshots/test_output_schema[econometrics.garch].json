  "$id": "urn:pyeconomics:model:econometrics.garch:1:output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "GARCH, GJR-GARCH and EGARCH over arch, with normal or Student's t errors and a zero or constant mean: each parameter with its standard error, the log-likelihood, AIC and BIC, persistence, the unconditional and last conditional volatility, and annualized variance forecasts.",
  "discriminator": {
    "mapping": {
      "egarch": "#/$defs/EgarchOutputs",
      "garch": "#/$defs/GarchOutputs",
      "gjr": "#/$defs/GjrOutputs"
    },
    "propertyName": "calculation"
  },
  "oneOf": [
