{
  "$defs": {
    "EqualRiskContributionInputs": {
      "additionalProperties": false,
      "description": "The portfolio in which every asset contributes the same risk.",
      "properties": {
        "calculation": {
          "const": "equal_risk_contribution",
          "default": "equal_risk_contribution",
          "description": "Risk parity: every asset contributes the same risk",
          "title": "Calculation",
          "type": "string"
        },
        "correlations": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maximum": 1.0,
                  "minimum": -1.0,
                  "type": "number",
                  "x-unit": "correlation"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Correlation matrix of the asset returns, as rows, with volatilities",
          "title": "Correlations"
        },
        "covariance": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maximum": 100.0,
                  "minimum": -100.0,
                  "type": "number",
                  "x-unit": "ratio"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Covariance matrix of the asset returns per period, as rows; or give volatilities and correlations, or returns",
          "title": "Covariance"
        },
        "returns": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maximum": 5.0,
                  "minimum": -1.0,
                  "type": "number",
                  "x-unit": "return"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              "maxLength": 2520,
              "minLength": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The assets' returns, as rows: one per period, one value per asset; their sample covariance (divisor T - 1) is used",
          "title": "Returns"
        },
        "volatilities": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0.0,
                "maximum": 10.0,
                "type": "number",
                "x-unit": "volatility"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Volatility of each asset per period, with correlations",
          "title": "Volatilities"
        }
      },
      "title": "EqualRiskContributionInputs",
      "type": "object"
    },
