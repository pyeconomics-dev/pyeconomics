  "$id": "urn:pyeconomics:model:portfolio.risk_based_allocation:1:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Long-only weights from the covariance alone: inverse volatility, equal risk contribution (risk parity) and hierarchical risk parity, with each asset's risk contribution and the portfolio's volatility.",
  "discriminator": {
    "mapping": {
      "equal_risk_contribution": "#/$defs/EqualRiskContributionInputs",
      "hierarchical_risk_parity": "#/$defs/HierarchicalRiskParityInputs",
      "inverse_volatility": "#/$defs/InverseVolatilityInputs"
    },
    "propertyName": "calculation"
  },
