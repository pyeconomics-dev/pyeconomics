{
  "$defs": {
    "CapmInputs": {
      "additionalProperties": false,
      "description": "The market factor alone, and a market premium for the security market line.",
      "properties": {
        "calculation": {
          "const": "capm",
          "default": "capm",
          "description": "CAPM: beta on the market and the security market line",
          "title": "Calculation",
          "type": "string"
        },
        "covariance": {
          "$ref": "#/$defs/CovarianceName",
          "default": "newey_west",
          "description": "Standard errors: 'newey_west' (heteroskedasticity and autocorrelation consistent), 'hc1' (heteroskedasticity consistent) or 'classical'"
        },
        "lags": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer",
              "x-unit": "count"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newey-West lags; left out, Newey and West's rule floor(4 (n/100)^(2/9))",
          "title": "Lags"
        },
        "market": {
          "description": "The return of the market's excess return (Mkt-RF) each period",
          "items": {
            "maximum": 10.0,
            "minimum": -10.0,
            "type": "number",
            "x-unit": "return"
          },
          "maxItems": 2520,
          "minItems": 3,
          "title": "Market",
          "type": "array"
        },
        "market_premium": {
          "description": "The expected market excess return per period, at which the security market line prices the asset's beta",
          "maximum": 10.0,
          "minimum": -10.0,
          "title": "Market Premium",
          "type": "number",
          "x-unit": "return"
        },
        "periods_per_year": {
          "description": "Periods in a year, to annualize alpha and the residual volatility: 12 for months, 52 for weeks, 252 for trading days",
          "maximum": 366,
          "minimum": 1,
          "title": "Periods Per Year",
          "type": "integer",
          "x-unit": "count"
        },
        "returns": {
          "description": "The asset's return each period; its excess return when risk_free is left out",
          "items": {
            "maximum": 10.0,
            "minimum": -10.0,
            "type": "number",
            "x-unit": "return"
          },
          "maxItems": 2520,
          "minItems": 3,
          "title": "Returns",
          "type": "array"
        },
        "risk_free": {
          "anyOf": [
            {
              "items": {
                "maximum": 10.0,
                "minimum": -10.0,
                "type": "number",
                "x-unit": "return"
              },
              "maxLength": 2520,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The risk-free return each period, subtracted from returns; leave it out when returns are already excess returns",
          "title": "Risk Free"
        },
        "risk_free_rate": {
          "default": 0.0,
          "description": "The risk-free return per period the security market line starts from; at 0 its expected return is the excess return",
          "maximum": 10.0,
          "minimum": -1.0,
          "title": "Risk Free Rate",
          "type": "number",
          "x-unit": "return"
        }
      },
      "required": [
        "returns",
        "market",
        "periods_per_year",
        "market_premium"
      ],
      "title": "CapmInputs",
      "type": "object"
    },
