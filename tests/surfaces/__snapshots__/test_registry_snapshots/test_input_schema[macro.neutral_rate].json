{
  "$defs": {
    "ConstantInputs": {
      "additionalProperties": false,
      "description": "A neutral rate the caller chooses.",
      "properties": {
        "calculation": {
          "const": "constant",
          "default": "constant",
          "description": "A constant real neutral rate",
          "title": "Calculation",
          "type": "string"
        },
        "inflation": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.2,
              "type": "number",
              "x-unit": "rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inflation, which makes the policy rate a real rate",
          "title": "Inflation"
        },
        "inflation_target": {
          "default": 0.02,
          "description": "The inflation objective",
          "maximum": 0.1,
          "minimum": 0.0,
          "title": "Inflation Target",
          "type": "number",
          "x-unit": "rate"
        },
        "policy_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -0.1,
              "type": "number",
              "x-unit": "rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A nominal policy rate, to measure how far it is from neutral",
          "title": "Policy Rate"
        },
        "real_rate": {
          "description": "The real neutral rate to use",
          "maximum": 0.1,
          "minimum": -0.1,
          "title": "Real Rate",
          "type": "number",
          "x-unit": "rate"
        }
      },
      "required": [
        "real_rate"
      ],
      "title": "ConstantInputs",
      "type": "object"
    },
    "HolstonLaubachWilliamsInputs": {
      "additionalProperties": false,
      "description": "A published Holston-Laubach-Williams (2017) estimate.",
      "properties": {
        "calculation": {
          "const": "holston_laubach_williams",
          "default": "holston_laubach_williams",
          "description": "r* from the Holston-Laubach-Williams model",
          "title": "Calculation",
          "type": "string"
        },
        "hlw_estimate": {
          "description": "The New York Fed's published Holston-Laubach-Williams estimate of r* for the economy and quarter",
          "maximum": 0.1,
          "minimum": -0.1,
          "title": "Hlw Estimate",
          "type": "number",
          "x-unit": "rate"
        },
        "inflation": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.2,
              "type": "number",
              "x-unit": "rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inflation, which makes the policy rate a real rate",
          "title": "Inflation"
        },
        "inflation_target": {
          "default": 0.02,
          "description": "The inflation objective",
          "maximum": 0.1,
          "minimum": 0.0,
          "title": "Inflation Target",
          "type": "number",
          "x-unit": "rate"
        },
        "policy_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -0.1,
              "type": "number",
              "x-unit": "rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A nominal policy rate, to measure how far it is from neutral",
          "title": "Policy Rate"
        }
      },
      "required": [
        "hlw_estimate"
      ],
      "title": "HolstonLaubachWilliamsInputs",
      "type": "object"
    },
    "LaubachWilliamsInputs": {
      "additionalProperties": false,
      "description": "A published Laubach-Williams (2003) estimate.",
      "properties": {
        "calculation": {
          "const": "laubach_williams",
          "default": "laubach_williams",
          "description": "r* from the Laubach-Williams model",
          "title": "Calculation",
          "type": "string"
        },
        "inflation": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.2,
              "type": "number",
              "x-unit": "rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inflation, which makes the policy rate a real rate",
          "title": "Inflation"
        },
        "inflation_target": {
          "default": 0.02,
          "description": "The inflation objective",
          "maximum": 0.1,
          "minimum": 0.0,
          "title": "Inflation Target",
          "type": "number",
          "x-unit": "rate"
        },
        "lw_estimate": {
          "description": "The New York Fed's published Laubach-Williams estimate of r* for the economy and quarter",
          "maximum": 0.1,
          "minimum": -0.1,
          "title": "Lw Estimate",
          "type": "number",
          "x-unit": "rate"
        },
        "policy_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
