{
  "$defs": {
    "EgarchInputs": {
      "additionalProperties": false,
      "description": "EGARCH(p, o, q): the log variance responds to standardized shocks.",
      "properties": {
        "asymmetric_lags": {
          "default": 1,
          "description": "Lags of the signed standardized-shock terms (gamma), o",
          "maximum": 2,
          "minimum": 0,
          "title": "Asymmetric Lags",
          "type": "integer",
          "x-unit": "count"
        },
        "calculation": {
          "const": "egarch",
          "default": "egarch",
          "description": "EGARCH (Nelson 1991)",
          "title": "Calculation",
          "type": "string"
        },
        "covariance": {
          "default": "robust",
          "description": "Standard errors: 'robust' (Bollerslev-Wooldridge quasi-maximum likelihood) or 'classic' (the inverse information matrix)",
          "enum": [
            "robust",
            "classic"
          ],
          "title": "Covariance",
          "type": "string"
        },
        "distribution": {
          "default": "normal",
          "description": "The standardized errors: normal, or Student's t with nu estimated",
          "enum": [
            "normal",
            "student_t"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "fixed_parameters": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000.0,
                "minimum": -1000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameters to evaluate instead of estimating, in the order of parameter_names and in decimal units; null estimates them",
          "title": "Fixed Parameters"
        },
        "horizon": {
          "default": 10,
          "description": "Periods to forecast the variance over",
          "maximum": 500,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer",
          "x-unit": "count"
        },
        "mean": {
          "default": "constant",
          "description": "The mean of the returns: a constant mu, or zero",
          "enum": [
            "constant",
            "zero"
          ],
          "title": "Mean",
          "type": "string"
        },
        "p": {
          "default": 1,
          "description": "Lags of the shock terms (alpha), p",
          "maximum": 2,
          "minimum": 1,
          "title": "P",
          "type": "integer",
          "x-unit": "count"
        },
        "periods_per_year": {
          "description": "Periods in a year, to annualize volatilities: 252 for trading days, 52 for weeks, 12 for months",
          "maximum": 366,
          "minimum": 1,
          "title": "Periods Per Year",
          "type": "integer",
          "x-unit": "count"
        },
        "q": {
          "default": 1,
          "description": "Lags of the variance terms (beta), q",
          "maximum": 2,
          "minimum": 0,
          "title": "Q",
          "type": "integer",
          "x-unit": "count"
        },
        "returns": {
          "description": "Returns per period, as decimals (0.01 is 1%), oldest first",
          "items": {
            "maximum": 10.0,
            "minimum": -10.0,
            "type": "number",
            "x-unit": "return"
          },
          "maxItems": 10000,
          "minItems": 100,
          "title": "Returns",
          "type": "array"
        },
        "seed": {
          "default": 0,
          "description": "Seed of the simulated forecasts: the same seed, the same draws",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seed",
          "type": "integer",
          "x-unit": "count"
        },
        "simulations": {
          "default": 1000,
          "description": "Simulated paths for forecasts beyond one period",
          "maximum": 10000,
          "minimum": 100,
          "title": "Simulations",
          "type": "integer",
          "x-unit": "count"
        }
      },
      "required": [
        "returns",
        "periods_per_year"
      ],
      "title": "EgarchInputs",
      "type": "object"
    },
