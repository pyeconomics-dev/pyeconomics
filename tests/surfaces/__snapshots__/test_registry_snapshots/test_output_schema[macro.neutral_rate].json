  "$defs": {
    "ConstantOutputs": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "const": "constant",
          "default": "constant",
          "description": "A constant real neutral rate",
          "title": "Calculation",
          "type": "string"
        },
        "nominal_neutral_rate": {
          "description": "The real neutral rate plus the inflation objective",
          "maximum": 0.2,
          "minimum": -0.1,
          "title": "Nominal Neutral Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "real_neutral_rate": {
          "description": "The real neutral rate, r*",
          "maximum": 0.2,
          "minimum": -0.2,
          "title": "Real Neutral Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "real_policy_gap": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": -2.0,
              "type": "number",
              "x-unit": "rate"
            },
            {
              "type": "null"
            }
          ],
          "description": "The real policy rate (policy rate less inflation) less r*; None without a policy rate",
          "title": "Real Policy Gap"
        }
      },
      "required": [
        "real_neutral_rate",
        "nominal_neutral_rate",
        "real_policy_gap"
      ],
