{
  "$defs": {
    "EvaluateInputs": {
      "additionalProperties": false,
      "description": "Nelson-Siegel or Svensson parameters and the maturities to evaluate.",
      "properties": {
        "beta0": {
          "description": "The long-run level: the yield as maturity grows",
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Beta0",
          "type": "number",
          "x-unit": "ratio"
        },
        "beta1": {
          "description": "The slope: beta0 + beta1 is the instantaneous short rate",
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Beta1",
          "type": "number",
          "x-unit": "ratio"
        },
        "beta2": {
          "description": "The first hump's size",
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Beta2",
          "type": "number",
          "x-unit": "ratio"
        },
        "beta3": {
          "default": 0.0,
          "description": "The second hump's size (Svensson); 0 for Nelson-Siegel",
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Beta3",
          "type": "number",
          "x-unit": "ratio"
        },
        "calculation": {
          "const": "evaluate",
          "default": "evaluate",
          "description": "Yields, forwards and par yields of given parameters",
          "title": "Calculation",
          "type": "string"
        },
        "coupon_frequency": {
          "$ref": "#/$defs/FrequencyName",
          "default": "semiannual",
          "description": "Coupons a year of the par bonds a par yield describes"
        },
        "maturities": {
          "default": [
            0.25,
            0.5,
            1.0,
            2.0,
            3.0,
            5.0,
            7.0,
            10.0,
            20.0,
            30.0
          ],
          "description": "Maturities to evaluate, in years",
          "items": {
            "exclusiveMinimum": 0.0,
            "maximum": 100.0,
            "type": "number",
            "x-unit": "years"
          },
          "maxItems": 360,
          "minItems": 1,
          "title": "Maturities",
          "type": "array"
        },
        "tau1": {
          "description": "The first decay, in years (GSW's TAU1)",
          "maximum": 200.0,
          "minimum": 0.001,
          "title": "Tau1",
          "type": "number",
          "x-unit": "years"
        },
        "tau2": {
          "anyOf": [
            {
              "maximum": 200.0,
              "minimum": 0.001,
              "type": "number",
              "x-unit": "years"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The second decay, in years (Svensson); omitted for Nelson-Siegel",
          "title": "Tau2"
        }
      },
      "required": [
        "beta0",
        "beta1",
        "beta2",
        "tau1"
      ],
      "title": "EvaluateInputs",
      "type": "object"
    },
    "FitInputs": {
      "additionalProperties": false,
      "description": "Observed yields to fit a Nelson-Siegel or Svensson curve to.",
      "properties": {
        "calculation": {
          "const": "fit",
          "default": "fit",
          "description": "Fit a curve to observed yields by least squares",
          "title": "Calculation",
          "type": "string"
        },
        "coupon_frequency": {
          "$ref": "#/$defs/FrequencyName",
          "default": "semiannual",
          "description": "Coupons a year of the par bonds a par yield describes"
        },
        "form": {
          "$ref": "#/$defs/Form",
          "default": "svensson",
          "description": "The curve to fit: 'nelson_siegel' (4 parameters) or 'svensson' (6)"
        },
        "maturities": {
          "description": "Maturity of each observed yield, in years, increasing",
          "items": {
            "exclusiveMinimum": 0.0,
            "maximum": 100.0,
            "type": "number",
            "x-unit": "years"
          },
          "maxItems": 60,
          "minItems": 4,
          "title": "Maturities",
          "type": "array"
        },
        "yield_type": {
          "$ref": "#/$defs/YieldType",
          "default": "par",
          "description": "What the observed yields are: 'par' (coupon rates of bonds priced at par, as Treasury's par curve gives them) or 'zero' (continuously compounded zero-coupon yields)"
        },
        "yields": {
          "description": "The observed yield at each maturity",
          "items": {
            "maximum": 1.0,
            "minimum": -0.1,
            "type": "number",
            "x-unit": "rate"
          },
          "maxItems": 60,
          "minItems": 4,
          "title": "Yields",
          "type": "array"
        }
      },
      "required": [
        "maturities",
        "yields"
      ],
      "title": "FitInputs",
      "type": "object"
    },
    "Form": {
      "enum": [
        "nelson_siegel",
        "svensson"
      ],
      "type": "string"
    },
    "FrequencyName": {
      "enum": [
        "annual",
        "semiannual",
        "quarterly",
        "monthly"
      ],
      "type": "string"
    },
    "YieldType": {
      "enum": [
        "zero",
        "par"
      ],
      "type": "string"
    }
  },
  "$id": "urn:pyeconomics:model:fixed_income.curve_fitting:1:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Zero yields, forward rates and par yields of Nelson-Siegel and Svensson curves, and least-squares fits of either curve to observed yields.",
  "discriminator": {
    "mapping": {
      "evaluate": "#/$defs/EvaluateInputs",
      "fit": "#/$defs/FitInputs"
    },
    "propertyName": "calculation"
  },
  "examples": [
    {
      "beta0": 0.045,
      "beta1": -0.01,
      "beta2": -0.02,
      "beta3": 0.015,
      "calculation": "evaluate",
      "coupon_frequency": "semiannual",
      "maturities": [
        0.25,
        0.5,
        1.0,
        2.0,
        3.0,
        5.0,
        7.0,
        10.0,
        20.0,
        30.0
      ],
      "tau1": 1.5,
      "tau2": 9.0
    },
    {
      "calculation": "fit",
      "coupon_frequency": "semiannual",
      "form": "nelson_siegel",
      "maturities": [
        0.25,
        0.5,
        1.0,
        2.0,
        3.0,
        5.0,
        7.0,
        10.0,
        20.0,
        30.0
      ],
      "yield_type": "par",
      "yields": [
        0.0433,
        0.0425,
        0.0402,
        0.0371,
        0.0362,
        0.0368,
        0.0381,
        0.0402,
        0.0451,
        0.0459
      ]
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/EvaluateInputs"
    },
    {
      "$ref": "#/$defs/FitInputs"
    }
  ],
  "title": "Nelson-Siegel and Svensson yield curves: inputs"
}
