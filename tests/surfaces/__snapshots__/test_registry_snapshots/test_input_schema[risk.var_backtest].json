{
  "$defs": {
    "ChristoffersenInputs": {
      "additionalProperties": false,
      "description": "An exception series of at least two observations.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "Size of the test (rejection probability)",
          "maximum": 0.5,
          "minimum": 0.001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "calculation": {
          "const": "christoffersen",
          "default": "christoffersen",
          "description": "Christoffersen's independence and conditional coverage tests",
          "title": "Calculation",
          "type": "string"
        },
        "confidence": {
          "default": 0.99,
          "description": "One-tailed confidence level, such as 0.99",
          "maximum": 0.9999,
          "minimum": 0.5,
          "title": "Confidence",
          "type": "number",
          "x-unit": "probability"
        },
        "exceptions": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "maxLength": 10080,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether each period's loss exceeded its VaR, in time order",
          "title": "Exceptions"
        },
        "profit_and_loss": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000000000.0,
                "minimum": -1000000000000000.0,
                "type": "number",
                "x-unit": "money"
              },
              "maxLength": 10080,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Profit (+) or loss (-) per period, in time order",
          "title": "Profit And Loss"
        },
        "value_at_risk": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000000000.0,
                "minimum": -1000000000000000.0,
                "type": "number",
                "x-unit": "money"
              },
              "maxLength": 10080,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Each period's VaR as a positive loss, in money",
          "title": "Value At Risk"
        }
      },
      "title": "ChristoffersenInputs",
      "type": "object"
