{
  "$defs": {
    "ChiSquareVarianceOutputs": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "const": "chi_square_variance",
          "default": "chi_square_variance",
          "description": "Chi-square test of a variance",
          "title": "Calculation",
          "type": "string"
        },
        "ci_lower": {
          "description": "Lower end of the two-sided 1 - alpha confidence interval",
          "maximum": 1e+30,
          "minimum": -1e+30,
          "title": "Ci Lower",
          "type": "number",
          "x-unit": "ratio"
        },
        "ci_upper": {
          "description": "Upper end of the two-sided 1 - alpha confidence interval",
          "maximum": 1e+30,
          "minimum": -1e+30,
          "title": "Ci Upper",
          "type": "number",
          "x-unit": "ratio"
        },
        "critical_values": {
          "description": "Bounds of the rejection region: lower and upper for a two-sided test, the one bound for a one-sided test",
          "items": {
            "maximum": 1e+30,
            "minimum": -1e+30,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Critical Values",
          "type": "array"
        },
        "degrees_of_freedom": {
          "description": "n - 1",
          "maximum": 2000000.0,
          "minimum": 0,
          "title": "Degrees Of Freedom",
          "type": "number",
          "x-unit": "ratio"
        },
        "estimate": {
          "description": "Point estimate of the quantity tested",
          "maximum": 1e+30,
          "minimum": -1e+30,
          "title": "Estimate",
          "type": "number",
          "x-unit": "ratio"
        },
        "p_value": {
          "description": "p-value for the chosen alternative",
          "maximum": 1,
          "minimum": 0,
          "title": "P Value",
          "type": "number",
          "x-unit": "probability"
        },
        "reject": {
          "description": "Whether the null hypothesis is rejected at alpha",
          "title": "Reject",
          "type": "boolean"
        },
        "statistic": {
          "description": "The test statistic",
          "maximum": 1e+30,
          "minimum": -1e+30,
          "title": "Statistic",
          "type": "number",
          "x-unit": "ratio"
        }
      },
      "required": [
        "statistic",
        "p_value",
        "critical_values",
        "reject",
        "estimate",
        "ci_lower",
        "ci_upper",
        "degrees_of_freedom"
      ],
      "title": "ChiSquareVarianceOutputs",
      "type": "object"
    },
