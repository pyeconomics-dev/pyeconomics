{
  "$defs": {
    "ArimaInputs": {
      "additionalProperties": false,
      "description": "One series and the orders of its seasonal ARIMA.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "description": "1 - the forecast intervals' coverage",
          "maximum": 0.5,
          "minimum": 0.001,
          "title": "Alpha",
          "type": "number",
          "x-unit": "probability"
        },
        "ar": {
          "default": 1,
          "description": "Autoregressive order, p",
          "maximum": 4,
          "minimum": 0,
          "title": "Ar",
          "type": "integer",
          "x-unit": "count"
        },
        "calculation": {
          "const": "arima",
          "default": "arima",
          "description": "ARIMA or seasonal ARIMA (Box and Jenkins)",
          "title": "Calculation",
          "type": "string"
        },
        "differences": {
          "default": 0,
          "description": "Order of differencing, d",
          "maximum": 2,
          "minimum": 0,
          "title": "Differences",
          "type": "integer",
          "x-unit": "count"
        },
        "horizon": {
          "default": 12,
          "description": "Periods to forecast",
          "maximum": 120,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer",
          "x-unit": "count"
        },
        "ma": {
          "default": 0,
          "description": "Moving-average order, q",
          "maximum": 4,
          "minimum": 0,
          "title": "Ma",
          "type": "integer",
          "x-unit": "count"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A name for each variable; the field names when null",
          "title": "Names"
        },
        "season": {
          "default": 0,
          "description": "Periods in a season, s (12 for months); 0 for no seasonal part",
          "maximum": 12,
          "minimum": 0,
          "title": "Season",
          "type": "integer",
          "x-unit": "count"
        },
        "seasonal_ar": {
          "default": 0,
          "description": "Seasonal autoregressive order, P",
          "maximum": 2,
          "minimum": 0,
          "title": "Seasonal Ar",
          "type": "integer",
          "x-unit": "count"
        },
        "seasonal_differences": {
          "default": 0,
          "description": "Order of seasonal differencing, D",
          "maximum": 1,
          "minimum": 0,
          "title": "Seasonal Differences",
          "type": "integer",
          "x-unit": "count"
        },
        "seasonal_ma": {
          "default": 0,
          "description": "Seasonal moving-average order, Q",
          "maximum": 2,
          "minimum": 0,
          "title": "Seasonal Ma",
          "type": "integer",
          "x-unit": "count"
        },
        "series": {
          "description": "The first (or only) variable, oldest first, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Series",
          "type": "array"
        },
        "trend": {
          "anyOf": [
            {
              "enum": [
                "n",
                "c",
                "t",
                "ct"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deterministic terms: none, a constant, a linear trend or both; null for a constant without differencing and none with it",
          "title": "Trend"
        }
      },
      "required": [
        "series"
      ],
      "title": "ArimaInputs",
      "type": "object"
    },
    "EngleGrangerInputs": {
      "additionalProperties": false,
      "description": "A dependent series and one to five regressors.",
      "properties": {
        "calculation": {
          "const": "engle_granger",
          "default": "engle_granger",
          "description": "The Engle-Granger two-step test",
          "title": "Calculation",
          "type": "string"
        },
        "fifth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fifth variable, if any",
          "title": "Fifth"
        },
        "fourth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fourth variable, if any",
          "title": "Fourth"
        },
        "lag_criterion": {
          "anyOf": [
            {
              "enum": [
                "aic",
                "bic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "aic",
          "description": "Chooses the ADF lags up to max_lags; null uses max_lags",
          "title": "Lag Criterion"
        },
        "max_lags": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 0,
              "type": "integer",
              "x-unit": "count"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The most ADF lags; null for min(24, ceil(12 (n / 100)^(1/4)))",
          "title": "Max Lags"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A name for each variable; the field names when null",
          "title": "Names"
        },
        "second": {
          "description": "The second variable, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Second",
          "type": "array"
        },
        "series": {
          "description": "The first (or only) variable, oldest first, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Series",
          "type": "array"
        },
        "sixth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The sixth variable, if any",
          "title": "Sixth"
        },
        "third": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The third variable, if any",
          "title": "Third"
        },
        "trend": {
          "default": "c",
          "description": "Deterministic terms of the cointegrating regression: a constant, a linear trend, or a quadratic one",
          "enum": [
            "c",
            "ct",
            "ctt"
          ],
          "title": "Trend",
          "type": "string"
        }
      },
      "required": [
        "series",
        "second"
      ],
      "title": "EngleGrangerInputs",
      "type": "object"
    },
    "JohansenInputs": {
      "additionalProperties": false,
      "description": "Two to six variables and the deterministic terms of the VECM.",
      "properties": {
        "calculation": {
          "const": "johansen",
          "default": "johansen",
          "description": "Johansen's trace and maximum-eigenvalue tests",
          "title": "Calculation",
          "type": "string"
        },
        "deterministic": {
          "default": "constant",
          "description": "Deterministic terms: none, a constant or a linear trend (statsmodels' det_order -1, 0 and 1)",
          "enum": [
            "none",
            "constant",
            "trend"
          ],
          "title": "Deterministic",
          "type": "string"
        },
        "fifth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fifth variable, if any",
          "title": "Fifth"
        },
        "fourth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fourth variable, if any",
          "title": "Fourth"
        },
        "lagged_differences": {
          "default": 1,
          "description": "Lagged differences in the VECM, k (a VAR of order k + 1); at least one, because statsmodels pairs the differences with the current level when there are none",
          "maximum": 12,
          "minimum": 1,
          "title": "Lagged Differences",
          "type": "integer",
          "x-unit": "count"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A name for each variable; the field names when null",
          "title": "Names"
        },
        "second": {
          "description": "The second variable, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Second",
          "type": "array"
        },
        "series": {
          "description": "The first (or only) variable, oldest first, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Series",
          "type": "array"
        },
        "significance": {
          "default": 0.05,
          "description": "The level the ranks are chosen at: 0.10, 0.05 or 0.01",
          "maximum": 0.1,
          "minimum": 0.01,
          "title": "Significance",
          "type": "number",
          "x-unit": "probability"
        },
        "sixth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The sixth variable, if any",
          "title": "Sixth"
        },
        "third": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The third variable, if any",
          "title": "Third"
        }
      },
      "required": [
        "series",
        "second"
      ],
      "title": "JohansenInputs",
      "type": "object"
    },
    "VarInputs": {
      "additionalProperties": false,
      "description": "Two to six variables, a lag order or a criterion to choose one.",
      "properties": {
        "calculation": {
          "const": "var",
          "default": "var",
          "description": "A vector autoregression (Sims 1980; Lütkepohl 2005)",
          "title": "Calculation",
          "type": "string"
        },
        "criterion": {
          "default": "aic",
          "description": "Lag selection: Akaike, Schwarz (BIC) or Hannan-Quinn",
          "enum": [
            "aic",
            "bic",
            "hqic"
          ],
          "title": "Criterion",
          "type": "string"
        },
        "fifth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fifth variable, if any",
          "title": "Fifth"
        },
        "fourth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fourth variable, if any",
          "title": "Fourth"
        },
        "horizon": {
          "default": 10,
          "description": "Periods of the impulse responses and variance decomposition",
          "maximum": 60,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer",
          "x-unit": "count"
        },
        "lags": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer",
              "x-unit": "count"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The lag order; null chooses it by criterion up to max_lags",
          "title": "Lags"
        },
        "max_lags": {
          "default": 4,
          "description": "The longest lag order the criterion tries",
          "maximum": 12,
          "minimum": 1,
          "title": "Max Lags",
          "type": "integer",
          "x-unit": "count"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A name for each variable; the field names when null",
          "title": "Names"
        },
        "second": {
          "description": "The second variable, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Second",
          "type": "array"
        },
        "series": {
          "description": "The first (or only) variable, oldest first, in its own units",
          "items": {
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "type": "number",
            "x-unit": "ratio"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Series",
          "type": "array"
        },
        "sixth": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The sixth variable, if any",
          "title": "Sixth"
        },
        "third": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000000000.0,
                "minimum": -1000000000.0,
                "type": "number",
                "x-unit": "ratio"
              },
              "maxLength": 2000,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The third variable, if any",
          "title": "Third"
        },
        "trend": {
          "default": "c",
          "description": "Deterministic terms: none, a constant, or both and a trend",
          "enum": [
            "n",
            "c",
            "ct"
          ],
          "title": "Trend",
          "type": "string"
        }
      },
      "required": [
        "series",
        "second"
      ],
      "title": "VarInputs",
      "type": "object"
    }
  },
