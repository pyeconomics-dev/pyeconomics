{
  "$defs": {
    "FamaMacBethInputs": {
      "additionalProperties": false,
      "description": "The test assets and factors, and how to run the cross-sections.",
      "properties": {
        "calculation": {
          "const": "fama_macbeth",
          "default": "fama_macbeth",
          "description": "Fama-MacBeth two-pass regressions of returns on betas",
          "title": "Calculation",
          "type": "string"
        },
        "factors": {
          "description": "The factors' returns, as rows: one per period, one value per factor. Each is the excess return of a traded portfolio",
          "items": {
            "items": {
              "maximum": 10.0,
              "minimum": -10.0,
              "type": "number",
              "x-unit": "return"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 2520,
          "minItems": 3,
          "title": "Factors",
          "type": "array"
        },
        "intercept": {
          "default": true,
          "description": "Include a constant in each cross-sectional regression: the zero-beta excess return; without it the constant is held at zero",
          "title": "Intercept",
          "type": "boolean"
        },
        "returns": {
          "description": "The test assets' returns, as rows: one per period, one value per asset; excess returns when risk_free is left out",
          "items": {
            "items": {
              "maximum": 10.0,
              "minimum": -10.0,
              "type": "number",
              "x-unit": "return"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 2520,
          "minItems": 3,
          "title": "Returns",
          "type": "array"
        },
        "risk_free": {
          "anyOf": [
            {
              "items": {
                "maximum": 10.0,
                "minimum": -10.0,
                "type": "number",
                "x-unit": "return"
              },
              "maxLength": 2520,
              "minLength": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The risk-free return each period, subtracted from every asset's return; leave it out when returns are already excess returns",
          "title": "Risk Free"
        }
      },
      "required": [
        "returns",
        "factors"
      ],
      "title": "FamaMacBethInputs",
      "type": "object"
    },
    "GrsInputs": {
      "additionalProperties": false,
