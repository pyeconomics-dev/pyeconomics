        "returns": {
          "description": "The test assets' returns, as rows: one per period, one value per asset; excess returns when risk_free is left out",
          "items": {
            "items": {
              "maximum": 10.0,
              "minimum": -10.0,
              "type": "number",
              "x-unit": "return"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 2520,
          "minItems": 3,
          "title": "Returns",
          "type": "array"
