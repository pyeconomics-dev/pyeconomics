{
  "$defs": {
    "AdjustedTaylor1993Outputs": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "const": "adjusted_taylor_1993",
          "default": "adjusted_taylor_1993",
          "description": "The adjusted Taylor (1993) rule",
          "title": "Calculation",
          "type": "string"
        },
        "inflation_gap_term": {
          "description": "The weight on inflation times its gap",
          "maximum": 20.0,
          "minimum": -20.0,
          "title": "Inflation Gap Term",
          "type": "number",
          "x-unit": "rate"
        },
        "nominal_neutral_rate": {
          "description": "The real neutral rate plus the target: the rate at no gaps",
          "maximum": 0.2,
          "minimum": -0.1,
          "title": "Nominal Neutral Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "prescribed_rate": {
          "description": "The policy rate the rule prescribes",
          "maximum": 20.0,
          "minimum": -20.0,
          "title": "Prescribed Rate",
          "type": "number",
          "x-unit": "rate"
        },
        "resource_gap_term": {
          "description": "The weight on the resource gap times the gap",
          "maximum": 20.0,
          "minimum": -20.0,
          "title": "Resource Gap Term",
          "type": "number",
          "x-unit": "rate"
        },
        "unconstrained_rate": {
          "description": "The prescription before the lower bound: the rule, smoothed",
          "maximum": 20.0,
          "minimum": -20.0,
          "title": "Unconstrained Rate",
          "type": "number",
          "x-unit": "rate"
        }
      },
      "required": [
        "prescribed_rate",
        "unconstrained_rate",
        "inflation_gap_term",
        "resource_gap_term",
        "nominal_neutral_rate"
      ],
      "title": "AdjustedTaylor1993Outputs",
      "type": "object"
    },
