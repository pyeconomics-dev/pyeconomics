    "PathOutputs": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "const": "path",
          "default": "path",
          "description": "A rule over a forecast",
          "title": "Calculation",
          "type": "string"
        },
        "horizon": {
          "description": "Horizons after the first: 0, 1, 2, ...",
          "items": {
            "maximum": 40,
            "minimum": 0,
            "type": "integer",
            "x-unit": "count"
          },
          "maxItems": 40,
          "title": "Horizon",
          "type": "array"
        },
        "lower_path": {
          "description": "The band's lower edge (low inflation, weak activity); empty with no band",
          "items": {
            "maximum": 500.0,
            "minimum": -500.0,
            "type": "number",
            "x-unit": "rate"
          },
          "maxItems": 40,
          "title": "Lower Path",
          "type": "array"
        },
        "prescribed_path": {
          "description": "The prescribed rate at each horizon",
          "items": {
            "maximum": 500.0,
            "minimum": -500.0,
            "type": "number",
            "x-unit": "rate"
          },
          "maxItems": 40,
          "title": "Prescribed Path",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/RuleName",
          "description": "The rule applied at each horizon"
        },
        "unconstrained_path": {
          "description": "Each prescription before the lower bound",
          "items": {
            "maximum": 500.0,
            "minimum": -500.0,
            "type": "number",
            "x-unit": "rate"
          },
          "maxItems": 40,
          "title": "Unconstrained Path",
          "type": "array"
        },
        "upper_path": {
          "description": "The band's upper edge (high inflation, strong activity); empty with no band",
          "items": {
            "maximum": 500.0,
            "minimum": -500.0,
            "type": "number",
            "x-unit": "rate"
          },
          "maxItems": 40,
          "title": "Upper Path",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "horizon",
        "prescribed_path",
        "unconstrained_path",
        "lower_path",
        "upper_path"
      ],
      "title": "PathOutputs",
      "type": "object"
    },
    "RuleName": {
      "enum": [
