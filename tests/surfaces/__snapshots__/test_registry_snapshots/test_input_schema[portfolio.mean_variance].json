  "$id": "urn:pyeconomics:model:portfolio.mean_variance:1:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Portfolio expected return and risk, the minimum-variance frontier with short sales, and the minimum-variance and tangency portfolios.",
