{
  "$defs": {
    "FrontierInputs": {
      "additionalProperties": false,
      "description": "How many points of the frontier to trace, and over which returns.",
      "properties": {
        "calculation": {
          "const": "frontier",
          "default": "frontier",
          "description": "Minimum-variance frontier, short sales allowed",
          "title": "Calculation",
          "type": "string"
        },
        "correlations": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maximum": 1.0,
                  "minimum": -1.0,
                  "type": "number",
                  "x-unit": "correlation"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Correlation matrix of the asset returns, as rows, with volatilities",
          "title": "Correlations"
        },
        "covariance": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maximum": 100.0,
                  "minimum": -100.0,
                  "type": "number",
                  "x-unit": "ratio"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Covariance matrix of the asset returns per period, as rows; or give volatilities and correlations",
          "title": "Covariance"
        },
        "expected_returns": {
          "description": "Expected return of each asset per period",
          "items": {
            "maximum": 100.0,
            "minimum": -1.0,
            "type": "number",
            "x-unit": "return"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Expected Returns",
          "type": "array"
        },
        "max_return": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": -1.0,
              "type": "number",
              "x-unit": "return"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest target return; by default the highest expected return of an asset",
          "title": "Max Return"
        },
        "min_return": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": -1.0,
              "type": "number",
              "x-unit": "return"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowest target return; by default the minimum-variance return",
          "title": "Min Return"
        },
        "points": {
          "default": 21,
          "description": "Number of target returns to trace",
          "maximum": 200,
          "minimum": 2,
          "title": "Points",
          "type": "integer",
          "x-unit": "count"
        },
        "volatilities": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0.0,
                "maximum": 10.0,
                "type": "number",
                "x-unit": "volatility"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Volatility of each asset per period, with correlations",
          "title": "Volatilities"
        }
      },
      "required": [
        "expected_returns"
      ],
      "title": "FrontierInputs",
      "type": "object"
    },
