  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Runs any registered model on its inputs, or binds its inputs to the data catalog first (as of a date, or the latest), and returns the canonical result: the validated inputs, the outputs, the warnings and the manifest of every source read. Data whose terms do not let it reach an AI assistant is never used.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A run of any model. Any of as_of, vintage, profile, concepts or parameters binds the model's data first; without them the model runs on its inputs alone.",
      "properties": {
        "as_of": {
          "description": "Bind the model's data as published on this date (YYYY-MM-DD).",
          "format": "date",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Field names mapped to catalog concept ids that replace their bindings' concepts.",
          "type": "object"
        },
        "inputs": {
          "description": "The model's inputs, as its input schema (describe_model) gives them. With a bind, each one given replaces the value the data would supply.",
          "type": "object"
        },
        "model_id": {
          "description": "A model id, or an alias of one.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "parameters": {
          "description": "Values of the bound concepts' parameters.",
          "type": "object"
        },
        "profile": {
          "description": "The named set of bindings to read; 'default' binds the latest data.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "vintage": {
          "description": "The vintage policy of every binding, in place of their own.",
          "enum": [
            "real_time",
            "latest"
          ]
        }
      },
      "required": [
        "model_id"
      ],
      "title": "run_model: inputs",
      "type": "object"
    },
    "name": "run_model",
    "outputSchema": {
      "$defs": {
        "manifest": {
          "additionalProperties": false,
          "properties": {
            "bit_generator": {
              "type": [
                "string",
                "null"
              ]
            },
            "data_sources": {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            "dependencies": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "inputs_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "model_id": {
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,2}$",
              "type": "string"
            },
            "model_version": {
              "minimum": 1,
              "type": "integer"
            },
            "package_version": {
              "type": "string"
            },
            "result_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "schema_version": {
              "const": 2
            },
            "seed": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "schema_version",
            "model_id",
            "model_version",
            "package_version",
            "dependencies",
            "seed",
            "bit_generator",
            "data_sources",
            "inputs_sha256",
            "result_sha256"
          ],
          "type": "object"
        },
        "notice": {
          "additionalProperties": false,
          "properties": {
            "download": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "const": "GET"
                    },
                    "path": {
                      "description": "The run's GET form on this server's REST API, which answers the same result; ?format= gives other formats.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "method",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model_id": {
              "type": "string"
            },
            "model_version": {
              "minimum": 1,
              "type": "integer"
            },
            "result_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "result_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "download",
            "model_id",
            "model_version",
            "result_bytes",
            "result_sha256",
            "summary"
          ],
          "type": "object"
        },
        "result": {
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object"
            },
            "manifest": {
              "$ref": "#/$defs/manifest"
            },
            "model_id": {
              "type": "string"
            },
            "model_version": {
              "minimum": 1,
              "type": "integer"
            },
            "outputs": {
              "type": "object"
            },
            "warnings": {
              "items": {
                "$ref": "#/$defs/warning"
              },
              "type": "array"
            }
          },
          "required": [
            "inputs",
            "manifest",
            "model_id",
            "model_version",
            "outputs",
            "warnings"
          ],
          "type": "object"
        },
        "warning": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/notice"
        }
      ],
      "description": "The run's result as canonical JSON (RFC 8785): the validated inputs and outputs, the warnings and the manifest. A result larger than the server's limit is replaced by a notice: its summary, size and hash, and the REST download that answers it.",
      "title": "run_model: result",
      "type": "object"
    },
    "title": "Model run"
  },
