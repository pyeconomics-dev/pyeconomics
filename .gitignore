# .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# uv, virtual environments and build output
.venv/
venv/
dist/
build/

# Tool caches and coverage
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.benchmarks/
htmlcov/
.coverage*
coverage.xml
coverage.json

# Generated documentation builds
docs/_build/
docs/reference/models/
docs/reference/providers/
docs/autoapi/
docs/.jupyter_cache/
/site/

# Secrets: environment files are never committed
.env
.env.*
secrets.py

# Local working directories. The 0.2.x cache lived in cache/ at the repository root;
# anchored, so the data layer's own cache package (src/pyeconomics/data/cache/) and its
# tests are tracked.
dev/
/cache/
.worktrees/

# roadmodel planning kit: personal posture, never commit
planning/user-context.md

# Local maintainer scripts
generate_tests.py
render_readme.py
output.html

# Editors, notebooks and operating systems
.idea/
.vscode/
*.swp
.ipynb_checkpoints/
.DS_Store
Thumbs.db
