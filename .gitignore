# .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# uv, virtual environments and build output
.venv/
venv/
dist/
dist-app/
build/

# Tool caches and coverage
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.benchmarks/
.wrangler/
htmlcov/
.coverage*
coverage.xml
coverage.json

# Generated documentation builds
docs/_build/
docs/study-paths/
docs/reference/models/
docs/reference/providers/
docs/reference/concepts/
docs/reference/sources.md
docs/problems.md
docs/autoapi/
docs/.jupyter_cache/
/site/

# The web app (Phase 5): its installed tools, build output, Astro's cache, the
# test and Lighthouse reports, and the site data and client every build
# regenerates (npm run data).
web/node_modules/
web/dist/
web/.astro/
web/src/data/generated/
web/src/client/
web/playwright-report/
web/test-results/
web/.lighthouse/
# The built site scripts/web/package_site.py copies into the app wheel's package
# (Phase 5 Step 10); never committed.
packages/pyeconomics-app/src/pyeconomics_app/site/

# Secrets: environment files are never committed
.env
.env.*
secrets.py

# Local working directories. The 0.2.x cache lived in cache/ at the repository root;
# anchored, so the data layer's own cache package (src/pyeconomics/data/cache/) and its
# tests are tracked.
dev/
/cache/
.worktrees/

# roadmodel planning kit: personal posture, never commit
planning/user-context.md

# Local maintainer scripts
generate_tests.py
render_readme.py
output.html

# Editors, notebooks and operating systems
.idea/
.vscode/
*.swp
.ipynb_checkpoints/
.DS_Store
Thumbs.db
